/* Shared base tokens; the reference palette below supplies semantic surface colors. */
page {
  --paper: #ffffff;
  --mist: #f8f9fa;
  --ink: #242823;
  --blue: #f8d849;
  --lilac: #e7efe8;
  --muted: rgba(36,40,35, .67);
  --line: rgba(36,40,35, .08);
  min-height: 100%;
  background: #f8f9fa;
  color: #242823;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "HarmonyOS Sans SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}
view, text, button, input, scroll-view { box-sizing: border-box; }
button { margin: 0; padding: 0; font: inherit; border: 0; color: inherit; background: transparent; border-radius: 0; }
button::after { border: 0; }
image { display: block; }
.page { position: relative; z-index: 1; padding: 28rpx 36rpx 190rpx; padding-bottom: calc(190rpx + env(safe-area-inset-bottom)); }
.scene { position: fixed; z-index: 0; top: 0; right: 0; bottom: 0; left: 0; pointer-events: none; background: #f8f9fa; overflow: hidden; }
.scene::before { position: absolute; content: ''; top: -150rpx; right: -160rpx; width: 680rpx; height: 640rpx; border-radius: 50%; background: radial-gradient(ellipse, rgba(233,236,231,.32), rgba(248,216,73,.06) 50%, rgba(255,255,255,0) 72%); }
.scene::after { position: absolute; content: ''; bottom: -170rpx; left: -190rpx; width: 700rpx; height: 650rpx; border-radius: 50%; background: radial-gradient(ellipse, rgba(248,216,73,.15), rgba(233,236,231,.08) 50%, rgba(255,255,255,0) 72%); }
.glass-card { background: rgba(255,255,255,.88); border: 1px solid rgba(36,40,35,.065); border-radius: 28rpx; backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); box-shadow: inset 0 1px 0 rgba(255,255,255,.65), 0 12rpx 36rpx rgba(36,40,35,.035); }
.page-heading { display: block; font-size: 48rpx; line-height: 1.3; letter-spacing: -1rpx; font-weight: 600; }
.page-caption { display: block; margin-top: 12rpx; color: var(--muted); font-size: 25rpx; line-height: 1.65; }
.section-bar { display: flex; align-items: center; justify-content: space-between; margin: 40rpx 0 24rpx; }
.section-title { font-size: 33rpx; font-weight: 600; letter-spacing: -.5rpx; }
.text-link { display: flex; align-items: center; justify-content: center; gap: 8rpx; min-height: 76rpx; color: #f8d849; font-size: 24rpx; }
.label { display: inline-flex; align-items: center; padding: 6rpx 16rpx; border-radius: 999rpx; color: #f8d849; background: rgba(248,216,73,.075); font-size: 21rpx; font-weight: 500; }
.meta { color: var(--muted); font-size: 23rpx; }
.cover { width: 100%; height: 100%; }
.pressable { transition: opacity .15s ease, transform .15s ease; }
.pressed { opacity: .76; transform: scale(.988); }
.separator { height: 1rpx; background: var(--line); }
.chapter-row { display: flex; width: 100%; align-items: center; gap: 20rpx; min-height: 108rpx; text-align: left; border-bottom: 1rpx solid var(--line); }
.chapter-row:last-child { border-bottom: 0; }
.chapter-index { flex-shrink: 0; display: flex; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; color: var(--muted); font-size: 24rpx; background: rgba(36,40,35,.04); border-radius: 16rpx; }
.chapter-main { flex: 1; min-width: 0; }
.chapter-name { display: block; font-size: 26rpx; line-height: 1.5; }
.chapter-status { display: block; margin-top: 4rpx; color: var(--muted); font-size: 21rpx; }
.chapter-row.is-current .chapter-index { color: #f8d849; background: rgba(248,216,73,.09); }
.chapter-row.is-current .chapter-name { color: #f8d849; font-weight: 500; }
.body-copy { color: rgba(36,40,35,.82); font-size: 28rpx; line-height: 1.9; }
.state-card { padding: 28rpx; margin: 24rpx 0; color: var(--muted); line-height: 1.8; }
.state-card > text { display: block; }
button[disabled] { opacity: .6; }
.surface-card{background:rgba(255,255,255,.87);border:1px solid rgba(36,40,35,.065);border-radius:28rpx;box-shadow:0 5rpx 20rpx rgba(36,40,35,.025)}
.eyebrow{display:block;font-size:22rpx;color:rgba(36,40,35,.48);letter-spacing:1rpx}
.section-title{font-size:31rpx;letter-spacing:-.6rpx}.section-caption{display:block;margin-top:8rpx;font-size:22rpx;color:rgba(36,40,35,.48)}
.subtle-action{display:flex;align-items:center;justify-content:center;gap:8rpx;min-width:88rpx;min-height:76rpx;font-size:23rpx;color:rgba(36,40,35,.6)}.subtle-action image,.small-arrow{width:24rpx;height:24rpx;opacity:.5}
.page-endnote{display:flex;align-items:center;justify-content:center;gap:18rpx;margin-top:44rpx;color:rgba(36,40,35,.36);font-size:20rpx}.page-endnote view{width:38rpx;height:1rpx;background:rgba(36,40,35,.1)}
.empty-state{display:flex;align-items:center;text-align:center;flex-direction:column;padding:52rpx 32rpx;gap:18rpx;margin:24rpx 0}.empty-state>image{width:56rpx;height:56rpx;opacity:.5;margin-bottom:8rpx}.empty-title{display:block;font-size:29rpx;font-weight:500}.empty-copy{display:block;font-size:24rpx;line-height:1.8;color:var(--muted)}.empty-state ui-button{min-width:220rpx;margin-top:8rpx}
.skeleton-stack{display:flex;flex-direction:column;gap:22rpx;margin:28rpx 0}.skeleton{background:linear-gradient(120deg,rgba(255,255,255,.85),rgba(233,236,231,.12));border:1px solid rgba(255,255,255,.85);border-radius:28rpx}.skeleton-hero{height:300rpx}.skeleton-line{width:50%;height:34rpx}.skeleton-row{height:180rpx}
@media (prefers-reduced-motion: reduce) { .pressable { transition: none; } }

/* Reference palette: neutral canvas, white surfaces, yellow actions. */
.scene { background: #f8f9fa; }
.scene::before, .scene::after { background: transparent; }
.surface-card, .glass-card { background: #ffffff; }

/* Shared tokens and geometry from the supplied UI export. */
page{--paper:#fff;--mist:#f8f9fa;--ink:#242823;--accent:#f8d849;--muted:#6e736f;--line:#e9ece7;--mint:#e7efe8;--blue:#f8d849;--lilac:#e7efe8;background:#f8f9fa;color:#242823}
.page{padding:28rpx 46rpx 200rpx;padding-bottom:calc(200rpx + env(safe-area-inset-bottom))}.home-page,.learn-page,.profile-page{padding-top:0}.brand-bar{display:flex;align-items:flex-start;gap:12rpx;box-sizing:border-box}.brand-bar>image{width:54rpx;height:54rpx;border-radius:15rpx}.brand-bar>text{font-size:36rpx;line-height:54rpx;font-weight:800}
.page-heading{font-size:54rpx;font-weight:800;color:#242823;letter-spacing:-1.5rpx}.page-caption{font-size:25rpx;color:#6e736f}.page-intro{margin:14rpx 0 46rpx}.surface-card,.glass-card{background:#fff;border:1rpx solid #e9ece7;border-radius:40rpx;box-shadow:none}.text-link,.label{color:#242823}.label{background:#fff5c7}.section-bar{margin:40rpx 0 18rpx}.section-title{font-size:36rpx;line-height:1.4;font-weight:800}.subtle-action{font-size:23rpx;color:#6e736f;min-height:64rpx}.subtle-action>image{width:24rpx;height:24rpx;opacity:.7}.meta{color:#6e736f;font-size:22rpx;line-height:1.7}.footnote{display:block;text-align:center;color:#6e736f;font-size:20rpx;line-height:1.9;letter-spacing:1rpx;margin:52rpx 0 20rpx}
.search-box{display:flex;align-items:center;gap:16rpx;background:#edf0ec;border-radius:28rpx;min-height:94rpx;padding:0 30rpx;margin-bottom:38rpx}.search-box>image{width:38rpx;height:38rpx;opacity:.6}.search-box input{flex:1;min-width:0;height:94rpx;font-size:26rpx;color:#242823}.search-box button{font-size:24rpx;min-height:80rpx;color:#242823}.filter-tabs{display:flex;gap:12rpx;margin-bottom:30rpx}.filter-tab{flex:1;min-width:0;padding:16rpx 4rpx;min-height:76rpx;border-radius:48rpx;color:#6e736f;font-size:24rpx;line-height:44rpx}.filter-tab.is-active{background:#242823;color:#fff;font-weight:600}.board-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28rpx 24rpx}.board-grid board-card{min-width:0}.icon-button{display:flex;align-items:center;justify-content:center;min-width:80rpx;min-height:80rpx}.icon-button>image{width:42rpx;height:42rpx}.row-arrow{width:30rpx;height:30rpx;flex-shrink:0;opacity:.65}.chapter-row.is-current .chapter-index{color:#242823;background:#f8d849}.chapter-row.is-current .chapter-name{color:#242823;font-weight:700}
@media(max-width:374px){.page{padding-left:32rpx;padding-right:32rpx}.greeting-title{font-size:44rpx}}
