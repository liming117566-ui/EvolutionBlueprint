/* Five base colors; all additional tones are opacity blends of these colors. */
page {
  --paper: #ffffff;
  --mist: #f3f6fb;
  --ink: #172b43;
  --blue: #416bf0;
  --lilac: #b7adeb;
  --muted: rgba(23, 43, 67, .67);
  --line: rgba(23, 43, 67, .08);
  min-height: 100%;
  background: #f3f6fb;
  color: #172b43;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "HarmonyOS Sans SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}
view, text, button, input, scroll-view { box-sizing: border-box; }
button { margin: 0; padding: 0; font: inherit; border: 0; color: inherit; background: transparent; border-radius: 0; }
button::after { border: 0; }
image { display: block; }
.page { position: relative; z-index: 1; padding: 28rpx 36rpx 190rpx; padding-bottom: calc(190rpx + env(safe-area-inset-bottom)); }
.scene { position: fixed; z-index: 0; top: 0; right: 0; bottom: 0; left: 0; pointer-events: none; background: #f3f6fb; overflow: hidden; }
.scene::before { position: absolute; content: ''; top: -150rpx; right: -160rpx; width: 680rpx; height: 640rpx; border-radius: 50%; background: radial-gradient(ellipse, rgba(183,173,235,.32), rgba(65,107,240,.06) 50%, rgba(255,255,255,0) 72%); }
.scene::after { position: absolute; content: ''; bottom: -170rpx; left: -190rpx; width: 700rpx; height: 650rpx; border-radius: 50%; background: radial-gradient(ellipse, rgba(65,107,240,.15), rgba(183,173,235,.08) 50%, rgba(255,255,255,0) 72%); }
.glass-card { background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,.68); border-radius: 40rpx; backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); box-shadow: inset 0 1px 0 rgba(255,255,255,.65), 0 12rpx 36rpx rgba(23,43,67,.035); }
.page-heading { display: block; font-size: 48rpx; line-height: 1.3; letter-spacing: -1rpx; font-weight: 600; }
.page-caption { display: block; margin-top: 12rpx; color: var(--muted); font-size: 25rpx; line-height: 1.65; }
.section-bar { display: flex; align-items: center; justify-content: space-between; margin: 40rpx 0 24rpx; }
.section-title { font-size: 33rpx; font-weight: 600; letter-spacing: -.5rpx; }
.text-link { display: flex; align-items: center; justify-content: center; gap: 8rpx; min-height: 76rpx; color: #416bf0; font-size: 24rpx; }
.label { display: inline-flex; align-items: center; padding: 6rpx 16rpx; border-radius: 999rpx; color: #416bf0; background: rgba(65,107,240,.075); font-size: 21rpx; font-weight: 500; }
.meta { color: var(--muted); font-size: 23rpx; }
.cover { width: 100%; height: 100%; }
.pressable { transition: opacity .15s ease, transform .15s ease; }
.pressed { opacity: .76; transform: scale(.988); }
.separator { height: 1rpx; background: var(--line); }
.chapter-row { display: flex; width: 100%; align-items: center; gap: 20rpx; min-height: 108rpx; text-align: left; border-bottom: 1rpx solid var(--line); }
.chapter-row:last-child { border-bottom: 0; }
.chapter-index { flex-shrink: 0; display: flex; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; color: var(--muted); font-size: 24rpx; background: rgba(23,43,67,.04); border-radius: 16rpx; }
.chapter-main { flex: 1; min-width: 0; }
.chapter-name { display: block; font-size: 26rpx; line-height: 1.5; }
.chapter-status { display: block; margin-top: 4rpx; color: var(--muted); font-size: 21rpx; }
.chapter-row.is-current .chapter-index { color: #416bf0; background: rgba(65,107,240,.09); }
.chapter-row.is-current .chapter-name { color: #416bf0; font-weight: 500; }
.body-copy { color: rgba(23,43,67,.82); font-size: 28rpx; line-height: 1.9; }
.state-card { padding: 28rpx; margin: 24rpx 0; color: var(--muted); line-height: 1.8; }
.state-card > text { display: block; }
button[disabled] { opacity: .6; }
@media (prefers-reduced-motion: reduce) { .pressable { transition: none; } }
