:host { position: relative; z-index: 1000; }
.sheet-root { position: fixed; z-index: 1000; top: 0; right: 0; bottom: 0; left: 0; }
.sheet-mask { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: rgba(36,40,35,.4); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); }
.sheet-panel { position: absolute; right: 16rpx; bottom: 0; left: 16rpx; box-sizing: border-box; overflow: hidden; padding: 16rpx 32rpx 24rpx; padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); border-radius: 48rpx 48rpx 0 0; background: #ffffff; border: 1px solid #e9ece7; box-shadow: 0 -16rpx 64rpx rgba(36,40,35,.12); }
.sheet-handle { width: 64rpx; height: 7rpx; margin: 0 auto 16rpx; border-radius: 999rpx; background: #d6dbd0; }
.sheet-header { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding-bottom: 20rpx; }
.sheet-title { min-width: 0; color: #242823; font-size: 38rpx; font-weight: 800; line-height: 1.35; }
.sheet-close { display: flex; flex-shrink: 0; align-items: center; justify-content: center; width: 80rpx; height: 80rpx; padding: 22rpx; border-radius: 50%; background: #edf0ec; }
.sheet-close image { width: 32rpx; height: 32rpx; }
.sheet-scroll { max-height: 55vh; height: 55vh; }
.sheet-content { padding: 4rpx 0 12rpx; }
.sheet-footer { padding-top: 20rpx; }
