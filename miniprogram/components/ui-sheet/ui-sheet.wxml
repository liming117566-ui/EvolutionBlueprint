<view wx:if="{{visible}}" class="sheet-root">
  <view class="sheet-mask" bindtap="close" catchtouchmove="stop" aria-label="关闭弹层"></view>
  <view class="sheet-panel" role="dialog" aria-label="{{title}}">
    <view class="sheet-handle"></view>
    <view class="sheet-header"><text class="sheet-title">{{title}}</text><button class="sheet-close" bindtap="close" aria-label="关闭"><image src="/assets/icons/close.svg" /></button></view>
    <scroll-view scroll-y class="sheet-scroll" style="height: {{compact ? '32vh' : '55vh'}}" enhanced show-scrollbar="{{false}}"><view class="sheet-content"><slot></slot></view></scroll-view>
    <view class="sheet-footer"><slot name="footer"></slot></view>
  </view>
</view>
