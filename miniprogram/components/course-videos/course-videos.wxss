.video-card{margin:32rpx 0;padding:32rpx;border:1px solid #e9ece7;border-radius:32rpx;background:#fff;color:#242823}.video-heading{font-size:32rpx;font-weight:700}.video-row{display:flex;align-items:center;gap:24rpx;margin-top:20rpx;padding:24rpx;text-align:left;border-radius:20rpx;background:#f8f9fa;font-size:28rpx}.video-row::after{border:0}.video-symbol{display:flex;align-items:center;justify-content:center;width:72rpx;height:72rpx;border-radius:16rpx;background:#fff5c7}.video-copy{flex:1;min-width:0}.video-title,.video-meta{display:block}.video-title{font-weight:600;overflow-wrap:anywhere}.video-meta{font-size:22rpx;color:#6e736f;margin-top:6rpx}.video-error{padding-top:20rpx;font-size:26rpx}
