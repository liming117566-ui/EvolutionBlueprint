:host{position:fixed;left:0;right:0;bottom:0;z-index:100}.dock-wrap{box-sizing:border-box;position:fixed;z-index:100;left:46rpx;right:46rpx;bottom:calc(22rpx + env(safe-area-inset-bottom))}.dock{box-sizing:border-box;display:flex;align-items:center;gap:12rpx;padding:14rpx;height:120rpx;border-radius:96rpx;background:rgba(255,255,255,.9);border:1rpx solid rgba(255,255,255,.95);backdrop-filter:blur(22px);box-shadow:0 15rpx 60rpx rgba(36,40,35,.09)}.dock-item{box-sizing:border-box;display:flex;align-items:center;justify-content:center;gap:14rpx;flex:1;min-width:0;height:92rpx;padding:0 10rpx;margin:0;border:0;border-radius:64rpx;background:transparent;color:#62695e;font-size:23rpx;line-height:1.4}.dock-item::after{border:0}.dock-icon{width:38rpx;height:38rpx;opacity:.7;flex-shrink:0;filter:brightness(0)}.dock-label{font-size:23rpx}.dock-item.is-active{background:#f8d849;color:#242823;font-weight:750}.is-active .dock-icon{opacity:1}.dock-dot{display:none}.dock-pressed{background:#fff5c7}@media(max-width:374px){.dock-wrap{left:32rpx;right:32rpx}}
