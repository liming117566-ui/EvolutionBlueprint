:host { display: block; }
.materials-card { margin: 32rpx 0; padding: 32rpx; border-radius: 40rpx; background: #ffffff; border: 1px solid #e9ece7; color: #242823; }
.materials-heading { font-size: 34rpx; line-height: 1.5; font-weight: 800; }
.materials-caption { margin-top: 8rpx; font-size: 23rpx; line-height: 1.6; color: #6e736f; }
.materials-state { padding: 32rpx 0 8rpx; font-size: 26rpx; line-height: 1.8; color: #6e736f; }
.materials-list { margin-top: 24rpx; }
.material-row { box-sizing: border-box; display: flex; align-items: center; width: 100%; margin: 20rpx 0 0; padding: 24rpx 20rpx; border: 1px solid #e9ece7; border-radius: 28rpx; background: #ffffff; color: #242823; text-align: left; line-height: 1.5; }
.material-row::after, .retry-button::after { border: none; }
.material-row[disabled] { color: #6e736f; background: #f8f9fa; }
.material-type { display: flex; flex-shrink: 0; align-items: center; justify-content: center; min-width: 86rpx; min-height: 104rpx; padding: 14rpx 8rpx; border-radius: 16rpx; text-align: center; font-size: 21rpx; font-weight: 700; color: #242823; background: #fff5c7; }
.material-copy { min-width: 0; flex: 1; margin-left: 24rpx; }
.material-title { font-size: 27rpx; font-weight: 700; overflow-wrap: anywhere; word-break: break-all; }
.material-meta { margin-top: 8rpx; color: #6e736f; font-size: 22rpx; }
.material-arrow { margin-left: 16rpx; color: #6e736f; font-size: 36rpx; }
.retry-button { margin: 20rpx 0 0; padding: 16rpx 28rpx; width: fit-content; min-height: 80rpx; border-radius: 28rpx; color: #242823; background: #f8d849; font-size: 26rpx; font-weight: 700; line-height: 1.8; }
.materials-open-error { margin-top: 24rpx; color: #242823; font-size: 25rpx; line-height: 1.7; }
