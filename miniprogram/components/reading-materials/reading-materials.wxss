:host { display: block; }
.materials-card {
  margin: 28rpx 0;
  padding: 32rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.15);
  border: 1px solid rgba(255, 255, 255, 1);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  color: #172B43;
  box-shadow: 0 12rpx 40rpx rgba(23, 43, 67, 0.04);
}
.materials-heading { font-size: 32rpx; line-height: 1.5; font-weight: 600; }
.materials-caption { margin-top: 6rpx; font-size: 23rpx; line-height: 1.6; color: rgba(23, 43, 67, 0.65); }
.materials-state { padding: 28rpx 0 8rpx; font-size: 26rpx; line-height: 1.8; color: rgba(23, 43, 67, 0.75); }
.materials-list { margin-top: 24rpx; }
.material-row {
  display: flex;
  align-items: center;
  width: 100%;
  margin: 14rpx 0 0;
  padding: 22rpx 20rpx;
  border-radius: 22rpx;
  background: rgba(243, 246, 251, 0.75);
  color: #172B43;
  text-align: left;
  line-height: 1.5;
}
.material-row::after, .retry-button::after { border: none; }
.material-row[disabled] { color: rgba(23, 43, 67, 0.65); background: rgba(243, 246, 251, 0.6); }
.material-type { flex-shrink: 0; min-width: 74rpx; padding: 14rpx 8rpx; border-radius: 14rpx; text-align: center; font-size: 23rpx; font-weight: 600; color: #416BF0; background: rgba(183, 173, 235, 0.2); }
.material-copy { min-width: 0; flex: 1; margin-left: 20rpx; }
.material-title { font-size: 27rpx; font-weight: 500; overflow-wrap: anywhere; word-break: break-all; }
.material-meta { margin-top: 5rpx; color: rgba(23, 43, 67, 0.65); font-size: 22rpx; }
.material-arrow { margin-left: 16rpx; color: #416BF0; font-size: 38rpx; }
.retry-button { margin: 20rpx 0 0; padding: 12rpx 24rpx; width: fit-content; min-height: 72rpx; border-radius: 999rpx; color: #416BF0; background: rgba(65, 107, 240, 0.08); font-size: 26rpx; line-height: 1.8; }
.materials-open-error { margin-top: 24rpx; color: #172B43; font-size: 25rpx; line-height: 1.7; }
