<button class="board board--{{variant}} tone--{{board.tone}}" bindtap="open" hover-class="board--pressed" aria-label="进入{{board.title}}，{{board.metaLabel || board.courseCount + '门课程'}}">
  <view class="board-icon"><image src="{{board.icon}}" /></view>
  <view class="board-content"><text class="board-title">{{board.title}}</text><text class="board-subtitle">{{board.subtitle}}</text><view class="board-meta"><text>{{board.metaLabel || (board.courseCount ? board.courseCount + ' 门课程' : '内容筹备中')}}</text><view class="board-arrow"><image src="/assets/icons/arrow.svg" /></view></view></view>
</button>
