<button class="board board--{{variant}}" bindtap="open" hover-class="board--pressed" aria-label="进入{{board.title}}"><image class="board-cover" src="{{board.cover}}" mode="aspectFill"/><view class="board-content"><text class="board-title">{{board.title}}</text><text class="board-meta">{{board.metaLabel || (board.courseCount ? board.courseCount + ' 门课程' : '互动学习')}} · {{board.accessible ? '已解锁' : '兑换后学习'}}</text><text wx:if="{{variant === 'row'}}" class="board-subtitle">{{board.subtitle}}</text></view><image wx:if="{{variant === 'row'}}" class="board-arrow" src="/assets/icons/ui-right.svg"/></button>
