:host{display:block;min-width:0}.board{box-sizing:border-box;display:block;background:transparent;border:0;padding:0;margin:0;width:100%;text-align:left;font-family:inherit;color:#242823;line-height:1.5;border-radius:24rpx}.board::after{border:0}.board-cover{display:block;width:100%;height:186rpx;border-radius:24rpx;background:#e7efe8}.board-title{display:block;font-size:27rpx;font-weight:700;margin-top:18rpx;line-height:1.55;overflow-wrap:anywhere}.board-meta{display:block;color:#6e736f;font-size:20rpx;margin-top:6rpx;line-height:1.7}.board-subtitle{display:block;font-size:22rpx;color:#6e736f;margin-top:8rpx}.board--row{display:flex;align-items:center;gap:24rpx;padding:24rpx;background:#fff;border:1rpx solid #e9ece7;border-radius:32rpx}.board--row .board-cover{width:200rpx;height:126rpx;flex-shrink:0;border-radius:20rpx}.board--row .board-content{flex:1;min-width:0}.board--row .board-title{font-size:27rpx;margin-top:0}.board-arrow{width:28rpx;height:28rpx;flex-shrink:0}.board--pressed{opacity:.8;transform:scale(.99)}
