:host{display:block;min-width:0}.board{box-sizing:border-box;width:100%;margin:0;text-align:left;border:1px solid rgba(25,26,29,.06);border-radius:28rpx;padding:28rpx;background:rgba(255,255,255,.86);box-shadow:0 5rpx 16rpx rgba(25,26,29,.025);transition:transform .15s ease,opacity .15s ease}.board::after{border:0}.board-icon{display:flex;align-items:center;justify-content:center;width:76rpx;height:76rpx;border:1px solid rgba(20,63,50,.06);border-radius:23rpx;background:rgba(20,63,50,.07);margin-bottom:24rpx}.board-icon image{width:44rpx;height:44rpx}.tone--lilac .board-icon{background:rgba(233,238,235,.17)}.tone--ink .board-icon{background:rgba(25,26,29,.045)}.board-title{display:block;font-size:30rpx;font-weight:600;line-height:1.4;letter-spacing:-.5rpx;color:#191a1d}.board-subtitle{display:block;color:rgba(25,26,29,.55);font-size:22rpx;line-height:1.7;margin-top:9rpx;min-height:74rpx}.board-meta{display:flex;align-items:center;justify-content:space-between;margin-top:16rpx;color:rgba(25,26,29,.5);font-size:21rpx}.board-arrow{display:flex;align-items:center;justify-content:center;width:38rpx;height:38rpx;border-radius:50%;background:rgba(248,248,249,.9)}.board-arrow image{width:22rpx;height:22rpx}.board--row{display:flex;align-items:center;gap:24rpx;padding:30rpx}.board--row .board-icon{flex-shrink:0;width:96rpx;height:96rpx;margin:0}.board--row .board-icon image{width:51rpx;height:51rpx}.board--row .board-content{flex:1;min-width:0}.board--row .board-subtitle{min-height:0;font-size:23rpx;margin-top:5rpx}.board--row .board-meta{margin-top:12rpx}.board--pressed{transform:scale(.985);opacity:.78}@media(prefers-reduced-motion:reduce){.board{transition:none}}

.board--compact .board-subtitle{max-width:220rpx;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.board-title{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;word-break:break-all}
.board { background: #ffffff; }
