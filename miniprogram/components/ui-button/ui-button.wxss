:host { display: block; }
.button { box-sizing: border-box; display: flex; align-items: center; justify-content: center; width: 100%; min-height: 96rpx; padding: 24rpx 32rpx; margin: 0; border: 1px solid transparent; border-radius: 28rpx; font-family: inherit; font-size: 28rpx; font-weight: 700; line-height: 1.4; transition: opacity .22s ease, transform .22s ease; }
.button::after { border: 0; }
.button--primary { color: #242823; background: #f8d849; }
.button--secondary { color: #242823; background: #ffffff; border-color: #d6dbd0; }
.button--ghost { color: #6e736f; background: transparent; }
.button--small { min-height: 80rpx; padding: 18rpx 24rpx; border-radius: 28rpx; font-size: 24rpx; }
.button--pressed { opacity: .8; transform: scale(.985); }
.button[disabled] { color: #6e736f; background: #edf0ec; border-color: #edf0ec; }
@media (prefers-reduced-motion: reduce) { .button { transition: none; } }
