<view class="page learn-page">
  <view class="brand-bar" style="height:{{chrome.height}}px;padding-top:{{chrome.top}}px"><image src="{{settings.logo}}"/><text>{{settings.brandName}}</text></view>
  <view class="page-intro"><text class="page-heading">学习，按你的节奏</text><text class="page-caption">每一个小进步，都值得被看见。</text></view>
  <view class="week-card"><view class="week-heading"><view><text class="week-title">本周学习足迹</text><text class="week-caption">一点一滴，慢慢积累</text></view><view class="week-number">{{stats.weekActive}}<text> 天</text></view></view><view class="week"><view wx:for="{{stats.week}}" wx:key="date" class="day {{item.active ? 'done' : ''}} {{item.today ? 'today' : ''}}"><text>{{item.label}}</text><view><image wx:if="{{item.active}}" src="/assets/icons/ui-check.svg"/><text wx:else>{{item.number}}</text></view></view></view></view>
  <view wx:if="{{error}}" class="state-card surface-card"><text>{{error}}</text><button class="text-link" bindtap="retry">重新加载</button></view>
  <view class="section-bar"><text class="section-title">我的学习空间</text></view>
  <view class="module-grid">
    <button class="module module-yellow" bindtap="goInteractive"><view class="module-icon"><image src="/assets/icons/ui-screen.svg"/></view><text class="module-title">互动式学习</text><text class="module-copy">在互动中，学得更透</text><view class="module-foot"><text>{{loading ? '正在读取课程' : boards.length + ' 个学习板块'}}</text><image src="/assets/icons/ui-arrow.svg"/></view></button>
    <button class="module module-mint" bindtap="goResources"><view class="module-icon"><image src="/assets/icons/ui-file.svg"/></view><text class="module-title">电子资料</text><text class="module-copy">好知识，随时翻一翻</text><view class="module-foot"><text>PDF · Word 学习资料</text><image src="/assets/icons/ui-arrow.svg"/></view></button>
    <button class="module" bindtap="goRecords"><view class="module-icon"><image src="/assets/icons/ui-clock.svg"/></view><text class="module-title">最近学习</text><text class="module-copy">再学一次，温故知新</text><view class="module-foot"><text>回到学过的课堂</text><image src="/assets/icons/ui-arrow.svg"/></view></button>
    <button class="module" bindtap="goPractice"><view class="module-icon"><image src="/assets/icons/ui-pencil.svg"/></view><text class="module-title">练习自测</text><text class="module-copy">小小练习，巩固所学</text><view class="module-foot"><text>选择课程开始练习</text><image src="/assets/icons/ui-arrow.svg"/></view></button>
    <button class="module" bindtap="goNotes"><view class="module-icon"><image src="/assets/icons/ui-book.svg"/></view><text class="module-title">学习笔记</text><text class="module-copy">把灵感，留给未来</text><view class="module-foot"><text>{{stats.notesCount}} 条学习收获</text><image src="/assets/icons/ui-arrow.svg"/></view></button>
    <button class="module" bindtap="goPlan"><view class="module-icon"><image src="/assets/icons/ui-calendar.svg"/></view><text class="module-title">学习计划</text><text class="module-copy">按自己的节奏进步</text><view class="module-foot"><text>每日 {{stats.goal}} 分钟小目标</text><image src="/assets/icons/ui-arrow.svg"/></view></button>
  </view><view class="study-tip"><image src="/assets/icons/ui-bulb.svg"/><text>学习不必赶路，找到自己的步调就好。</text></view>
</view><glass-nav id="main-nav" active="learn" settings="{{settings}}"/>
