<view class="scene" aria-hidden="true"></view>
<view class="page learn-page">
  <text class="eyebrow">给成长一个清晰的方向</text><text class="page-heading learning-heading">{{settings.nav[1].label}}空间</text><text class="page-caption">先选一个方向，再走进属于你的课堂。</text>
  <view class="search-field"><image src="/assets/icons/search.svg" /><input value="{{query}}" bindinput="search" placeholder="搜索学习板块" placeholder-class="search-placeholder" confirm-type="search" maxlength="80" aria-label="搜索学习板块" /><button wx:if="{{query}}" bindtap="clearQuery" aria-label="清除搜索"><image src="/assets/icons/close.svg" /></button></view>
  <view class="filter-tabs" role="tablist"><button wx:for="{{groups}}" wx:key="id" class="filter-tab {{group === item.id ? 'is-active' : ''}}" data-id="{{item.id}}" bindtap="selectGroup" role="tab" aria-selected="{{group === item.id}}" hover-class="pressed">{{item.title}}</button></view>
  <view wx:if="{{loading}}" class="skeleton-stack"><view class="skeleton skeleton-row"></view><view class="skeleton skeleton-row"></view><view class="skeleton skeleton-row"></view></view>
  <view wx:elif="{{error}}" class="empty-state surface-card"><text class="empty-title">暂时无法加载</text><text class="empty-copy">{{error}}</text><ui-button size="small" label="重试" bind:activate="retry" /></view>
  <block wx:else><view class="list-caption"><text>{{group === 'all' ? '全部学习板块' : '分类学习板块'}}</text><text>{{filtered.length}} 个方向</text></view><view class="board-list"><board-card wx:for="{{filtered}}" wx:key="id" board="{{item}}" variant="row" bind:open="openBoard" /></view><view wx:if="{{!filtered.length}}" class="empty-state surface-card"><image src="/assets/icons/search.svg" /><text class="empty-title">{{query ? '没有找到这个学习方向' : '这个分类还在准备中'}}</text><text class="empty-copy">试试其他关键词，或查看全部板块。</text><ui-button id="reset-filter" variant="secondary" size="small" label="查看全部" bind:activate="clearSearch" /></view><view class="page-endnote"><view></view><text>按自己的节奏，慢慢来</text><view></view></view></block>
</view>
<glass-nav id="main-nav" active="learn" settings="{{settings}}" />
