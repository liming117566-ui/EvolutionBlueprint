.learn-page { padding-top: 20rpx; }
.course-tabs { display: flex; align-items: center; gap: 8rpx; padding: 8rpx; margin: 32rpx 0 24rpx; border: 1px solid rgba(255,255,255,.65); border-radius: 999rpx; background: rgba(23,43,67,.035); }
.course-tab { flex: 1; min-height: 78rpx; display: flex; align-items: center; justify-content: center; border-radius: 999rpx; color: var(--muted); font-size: 25rpx; }
.course-tab.is-active { background: rgba(255,255,255,.8); color: #172b43; box-shadow: 0 3rpx 10rpx rgba(23,43,67,.035); font-weight: 500; }
.learning-card { padding: 12rpx; overflow: hidden; }
.learning-cover { height: 296rpx; border-radius: 30rpx; overflow: hidden; }
.learning-body { padding: 25rpx 18rpx 18rpx; }
.learning-title-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.learning-title { font-size: 36rpx; font-weight: 600; }
.learning-description { display: block; margin-top: 16rpx; color: var(--muted); font-size: 25rpx; line-height: 1.8; }
.learning-status { display: flex; justify-content: space-between; margin-top: 26rpx; color: var(--muted); font-size: 22rpx; }
.learning-action { margin-top: 24rpx; }
.chapter-card { padding: 6rpx 28rpx; border-radius: 32rpx; }
.chapter-index image { width: 30rpx; height: 30rpx; }
.chapter-chevron { width: 26rpx; height: 26rpx; opacity: .45; }
