.week-card{padding:38rpx;background:#242823;color:#fff;border-radius:40rpx;margin-bottom:46rpx}.week-heading{display:flex;align-items:center;justify-content:space-between}.week-title{display:block;font-size:27rpx;font-weight:500}.week-caption{display:block;font-size:21rpx;color:#c1c7b9;margin-top:6rpx}.week-number{font-size:62rpx;font-weight:750;line-height:1.2}.week-number>text{font-size:24rpx;color:#c1c7b9;font-weight:400}.week{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:12rpx;margin-top:38rpx}.day{display:flex;flex-direction:column;align-items:center;gap:16rpx;font-size:20rpx;color:#c1c7b9}.day>view{display:flex;align-items:center;justify-content:center;width:54rpx;height:54rpx;border-radius:50%;background:#3c4239;color:#dbe0d5;font-size:23rpx}.day.today>view{box-shadow:0 0 0 2rpx #f8d849}.day.done>view{background:#f8d849;color:#242823}.day image{width:30rpx;height:30rpx}.module-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24rpx}.module{display:flex;flex-direction:column;align-items:flex-start;min-width:0;min-height:310rpx;padding:34rpx 28rpx 28rpx;background:#fff;border:1rpx solid #e9ece7;border-radius:40rpx;text-align:left}.module-yellow{background:#f8d849;border-color:#f8d849}.module-mint{background:#e7efe8;border-color:#e7efe8}.module-icon{display:flex;align-items:center;justify-content:center;width:78rpx;height:78rpx;background:rgba(255,255,255,.65);border-radius:24rpx;margin-bottom:28rpx}.module-icon>image{width:46rpx;height:46rpx}.module-title{font-size:29rpx;font-weight:750}.module-copy{font-size:21rpx;color:#61675d;margin-top:7rpx}.module-foot{display:flex;align-items:center;justify-content:space-between;gap:6rpx;width:100%;font-size:19rpx;color:#606656;margin-top:20rpx}.module-foot>image{width:30rpx;height:30rpx;flex-shrink:0}.study-tip{display:flex;align-items:center;gap:22rpx;margin-top:46rpx;color:#6e736f;font-size:22rpx}.study-tip>image{width:40rpx;height:40rpx;flex-shrink:0}
.module.print-module { grid-column: 1 / -1; flex-direction: row; align-items: center; gap: 24rpx; min-height: 144rpx; padding: 24rpx 28rpx; background: #dcebdc; border-color: #dcebdc; }
.print-module .module-icon { margin: 0; flex-shrink: 0; }
.print-module-copy { flex: 1; min-width: 0; }
.print-module-copy > text { display: block; }
.print-module-arrow { width: 34rpx; height: 34rpx; flex-shrink: 0; }
