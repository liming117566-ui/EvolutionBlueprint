.gate-page { position: relative; z-index: 1; min-height: 100vh; padding: 0 48rpx 56rpx; color: #242823; }
.gate-brand { display: flex; align-items: center; gap: 16rpx; font-size: 36rpx; font-weight: 800; letter-spacing: 1rpx; }
.gate-brand image { width: 56rpx; height: 56rpx; border-radius: 18rpx; }
.gate-art { position: relative; height: 320rpx; margin: 36rpx 0 48rpx; padding: 20rpx; background: #f8d849; border-radius: 40rpx; }
.gate-art > .cover { mix-blend-mode: multiply; }
.art-label { position: absolute; bottom: -22rpx; left: 50%; display: flex; align-items: center; gap: 12rpx; padding: 14rpx 24rpx; border-radius: 24rpx; transform: translateX(-50%); white-space: nowrap; color: #242823; background: #ffffff; border: 1px solid #e9ece7; font-size: 23rpx; font-weight: 700; }
.art-label image { width: 28rpx; height: 28rpx; }
.gate-intro { margin-top: 40rpx; text-align: left; }
.gate-intro .page-heading { font-size: 48rpx; font-weight: 800; line-height: 1.35; letter-spacing: -1rpx; }
.gate-intro .page-caption { margin-top: 16rpx; color: #6e736f; font-size: 25rpx; line-height: 1.8; }
.gate-form { margin-top: 32rpx; padding: 32rpx; border-radius: 40rpx; background: #ffffff; border-color: #e9ece7; box-shadow: none; }
.input-label { display: block; margin-bottom: 16rpx; font-size: 24rpx; font-weight: 700; line-height: 1.65; }
.input-wrap { display: flex; align-items: center; min-height: 96rpx; margin-bottom: 24rpx; padding: 0 24rpx; border: 1px solid #d6dbd0; border-radius: 28rpx; background: #f8f9fa; }
.input-wrap:focus-within { border-color: #242823; box-shadow: 0 0 0 4rpx #fff5c7; }
.input-wrap.has-error { border-color: #b04432; }
.code-input { width: 100%; height: 96rpx; color: #242823; font-size: 28rpx; line-height: 1.4; }
.input-placeholder { color: #6e736f; }
.form-error { display: block; margin: -8rpx 0 20rpx; color: #b04432; font-size: 23rpx; line-height: 1.7; }
.form-hint { display: block; margin-top: 24rpx; color: #6e736f; font-size: 22rpx; text-align: center; line-height: 1.7; }
.gate-help { display: flex; align-items: center; justify-content: center; min-height: 88rpx; margin: 12rpx auto 0; color: #6e736f; font-size: 24rpx; }
.gate-footnote { display: block; margin-top: 24rpx; color: #6e736f; text-align: center; font-size: 21rpx; letter-spacing: 2rpx; }
.help-copy { display: block; margin-bottom: 24rpx; color: #6e736f; font-size: 27rpx; line-height: 1.85; }
@media (max-height: 700px) { .gate-art { height: 230rpx; margin-top: 24rpx; } .gate-intro { margin-top: 24rpx; } .gate-footnote { margin-top: 8rpx; } }
