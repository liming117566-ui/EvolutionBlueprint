.interactive-page{padding-bottom:70rpx}.list-caption{display:flex;align-items:center;justify-content:space-between;font-size:22rpx;color:#6e736f;margin:0 0 28rpx}.filter-tab{font-size:22rpx}.page-intro{margin-top:22rpx}
.access-filters{display:flex;align-items:center;gap:12rpx}
