<view class="page interactive-page"><view class="page-intro"><text class="page-heading">{{title}}</text><text class="page-caption">{{caption}}</text></view><view class="search-box"><image src="/assets/icons/ui-search.svg"/><input value="{{query}}" bindinput="search" placeholder="搜索课程或学习方向" confirm-type="search" aria-label="搜索课程" maxlength="80"/></view><view class="filter-tabs"><button wx:for="{{groups}}" wx:key="id" class="filter-tab {{group === item.id ? 'is-active' : ''}}" data-id="{{item.id}}" bindtap="selectGroup">{{item.title}}</button></view><view wx:if="{{loading}}" class="skeleton-stack"><view class="skeleton skeleton-hero"></view><view class="skeleton skeleton-hero"></view></view><view wx:elif="{{error}}" class="empty-state surface-card"><text class="empty-title">暂时无法加载</text><text class="empty-copy">{{error}}</text><ui-button size="small" label="重新加载" bind:activate="retry"/></view><block wx:else><view class="list-caption"><text>{{mode === 'all' ? '全部课程' : title}}</text><text>{{filtered.length}} 个学习板块</text></view><view class="board-grid"><board-card wx:for="{{filtered}}" wx:key="id" board="{{item}}" bind:open="openBoard"/></view><view wx:if="{{!filtered.length}}" class="empty-state surface-card"><text class="empty-title">{{mode === 'records' ? '还没有最近学习的板块' : mode === 'unlocked' ? '还没有匹配的已解锁课程' : '暂时没有匹配的课程'}}</text><text class="empty-copy">{{mode === 'records' ? '进入一门已解锁的课程，这里就会留下足迹。' : '试试其他关键词，或查看全部课程。'}}</text><ui-button variant="secondary" label="{{mode === 'records' || mode === 'unlocked' ? '浏览全部课程' : '清除筛选'}}" size="small" bind:activate="resetList"/></view></block><text class="footnote">保持好奇，进步自然发生。</text></view>
