.resources-page{padding-bottom:70rpx}.library-caption{display:block;color:#6e736f;font-size:23rpx;margin:30rpx 0}.resource{display:flex;align-items:center;gap:24rpx;width:100%;padding:30rpx;background:#fff;border:1rpx solid #e9ece7;border-radius:32rpx;margin-bottom:24rpx;text-align:left}.file-icon{display:flex;align-items:center;justify-content:center;width:90rpx;height:106rpx;border-radius:16rpx;background:#fff5c7;flex-shrink:0}.file-icon>image{width:44rpx;height:44rpx}.resource-main{flex:1;min-width:0}.resource-title{display:block;font-size:27rpx;font-weight:650;overflow-wrap:anywhere}.resource-copy{display:block;font-size:22rpx;color:#6e736f;margin-top:9rpx}.open-error{display:block;margin:24rpx 0;color:#b04432;font-size:24rpx;line-height:1.8}
