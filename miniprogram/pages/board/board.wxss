.board-page{padding-top:20rpx;padding-bottom:70rpx}.board-intro{padding:10rpx 0 30rpx}.intro-badge{display:flex;align-items:center;gap:10rpx;color:#143f32;font-size:22rpx;margin-bottom:24rpx}.intro-badge image{width:35rpx;height:35rpx}.board-intro .page-heading{font-size:50rpx}.board-intro .page-caption{font-size:24rpx;line-height:1.9;max-width:620rpx;margin-top:18rpx}.intro-stats{display:flex;align-items:center;gap:18rpx;font-size:21rpx;color:rgba(25,26,29,.5);margin-top:24rpx}.intro-stats view{width:5rpx;height:5rpx;background:rgba(25,26,29,.25);border-radius:50%}.feature-grid{display:flex;gap:14rpx;margin:8rpx 0 34rpx}.feature-card{position:relative;flex:1;min-width:0;text-align:left;padding:24rpx 18rpx 28rpx;border-radius:24rpx}.feature-icon{display:flex;align-items:center;justify-content:center;width:56rpx;height:56rpx;background:rgba(20,63,50,.06);border-radius:17rpx;margin-bottom:20rpx}.feature-icon image{width:31rpx;height:31rpx}.feature-title{display:block;font-size:25rpx;font-weight:600;line-height:1.4}.feature-description{display:block;font-size:18rpx;line-height:1.6;margin-top:9rpx;color:rgba(25,26,29,.5);min-height:58rpx}.feature-card.is-active{border-color:rgba(20,63,50,.32);background:rgba(255,255,255,.95);box-shadow:0 6rpx 24rpx rgba(20,63,50,.06)}.feature-indicator{position:absolute;bottom:14rpx;left:20rpx;width:22rpx;height:4rpx;border-radius:4rpx;background:transparent}.is-active .feature-indicator{background:#143f32}.board-course{display:block;overflow:hidden;width:100%;text-align:left;padding:12rpx;margin-bottom:22rpx}.board-course-cover{position:relative;height:272rpx;overflow:hidden;border-radius:21rpx;background:rgba(233,238,235,.1)}.board-course-cover>image{width:100%;height:100%}.course-state{position:absolute;top:18rpx;left:18rpx;font-size:19rpx;border-radius:999rpx;padding:7rpx 16rpx;background:rgba(255,255,255,.87);color:rgba(25,26,29,.7);border:1rpx solid rgba(255,255,255,.9)}.board-course-body{padding:24rpx 15rpx 13rpx}.board-course-title{display:block;font-size:33rpx;font-weight:600}.board-course-subtitle{display:block;font-size:23rpx;color:var(--muted);margin-top:9rpx;line-height:1.8}.board-course-foot{display:flex;justify-content:space-between;align-items:center;gap:14rpx;border-top:1rpx solid var(--line);padding-top:21rpx;margin-top:24rpx;font-size:21rpx;color:rgba(25,26,29,.55)}.board-course-foot>view{display:flex;gap:6rpx;align-items:center;color:#143f32}.board-course-foot image{width:22rpx;height:22rpx}.exercise-list{padding:0 26rpx}.exercise-list:empty{display:none}.exercise-row{display:flex;align-items:center;gap:20rpx;min-height:138rpx;border-bottom:1rpx solid var(--line);width:100%;text-align:left}.exercise-row:last-child{border:0}.exercise-index{display:flex;align-items:center;justify-content:center;flex-shrink:0;width:50rpx;height:50rpx;font-size:22rpx;color:#143f32;background:rgba(20,63,50,.06);border-radius:16rpx}.exercise-main{flex:1;min-width:0;font-size:26rpx}.exercise-sub{display:block;font-size:21rpx;color:var(--muted);margin-top:7rpx}.exercise-row>image{width:25rpx;height:25rpx;opacity:.4}.progress-summary{display:flex;justify-content:space-around;padding:36rpx 20rpx}.progress-summary>view{display:flex;flex-direction:column;align-items:center;gap:7rpx}.progress-value{font-size:54rpx;font-weight:600;line-height:1.3;color:#143f32}.progress-course{width:100%;text-align:left;padding:30rpx;margin-top:20rpx}.progress-course-top{display:flex;justify-content:space-between;font-size:27rpx;font-weight:500;gap:20rpx}.progress-course-top text:last-child{color:#143f32}.progress-track{height:8rpx;background:rgba(20,63,50,.08);border-radius:8rpx;overflow:hidden;margin:24rpx 0 16rpx}.progress-track view{height:100%;background:#143f32;border-radius:8rpx}
