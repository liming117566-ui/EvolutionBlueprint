.board-page { padding-top: 16rpx; padding-bottom: 80rpx; }
.board-intro { padding: 8rpx 0 32rpx; }
.intro-badge { display: inline-flex; align-items: center; gap: 12rpx; padding: 10rpx 18rpx; color: #242823; font-size: 21rpx; font-weight: 700; background: #fff5c7; border-radius: 16rpx; margin-bottom: 24rpx; }
.intro-badge image { width: 34rpx; height: 34rpx; }
.board-intro .page-heading { font-size: 50rpx; font-weight: 800; letter-spacing: -1rpx; }
.board-intro .page-caption { font-size: 26rpx; line-height: 1.8; max-width: 640rpx; margin-top: 16rpx; color: #6e736f; }
.intro-stats { display: flex; flex-wrap: wrap; align-items: center; gap: 18rpx; font-size: 22rpx; color: #6e736f; margin-top: 24rpx; }
.intro-stats view { width: 5rpx; height: 5rpx; background: #6e736f; border-radius: 50%; }
.feature-grid { display: flex; gap: 16rpx; margin: 8rpx 0 32rpx; }
.feature-card { position: relative; flex: 1; min-width: 0; text-align: left; padding: 24rpx 18rpx 30rpx; border: 1px solid #e9ece7; border-radius: 32rpx; background: #ffffff; box-shadow: none; }
.feature-icon { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; background: #edf0ec; border-radius: 20rpx; margin-bottom: 24rpx; }
.feature-icon image { width: 34rpx; height: 34rpx; }
.feature-title { display: block; font-size: 26rpx; font-weight: 750; line-height: 1.4; color: #242823; }
.feature-description { display: block; font-size: 20rpx; line-height: 1.65; margin-top: 10rpx; color: #6e736f; min-height: 66rpx; }
.feature-card.is-active { border-color: #f8d849; background: #f8d849; box-shadow: none; }
.is-active .feature-icon { background: rgba(255,255,255,.65); }
.is-active .feature-description { color: #60571e; }
.feature-indicator { position: absolute; bottom: 16rpx; left: 20rpx; width: 22rpx; height: 4rpx; border-radius: 4rpx; background: transparent; }
.is-active .feature-indicator { background: #242823; }
.board-course { display: block; overflow: hidden; width: 100%; text-align: left; padding: 0; margin-bottom: 24rpx; border-radius: 40rpx; }
.board-course-cover { position: relative; height: 320rpx; overflow: hidden; background: #e7efe8; }
.board-course-cover > image { width: 100%; height: 100%; }
.course-state { position: absolute; top: 24rpx; left: 24rpx; font-size: 20rpx; font-weight: 700; border-radius: 12rpx; padding: 8rpx 16rpx; background: #ffffff; color: #242823; }
.board-course-body { padding: 28rpx 32rpx 26rpx; }
.board-course-title { display: block; font-size: 32rpx; font-weight: 800; color: #242823; }
.board-course-subtitle { display: block; font-size: 24rpx; color: #6e736f; margin-top: 10rpx; line-height: 1.8; }
.board-course-foot { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; border-top: 1rpx solid #e9ece7; padding-top: 24rpx; margin-top: 24rpx; font-size: 21rpx; color: #6e736f; }
.board-course-foot > view { display: flex; flex-shrink: 0; gap: 8rpx; align-items: center; color: #242823; font-weight: 700; }
.board-course-foot image { width: 24rpx; height: 24rpx; }
.exercise-list { padding: 0 32rpx; }
.exercise-list:empty { display: none; }
.exercise-row { display: flex; align-items: center; gap: 24rpx; min-height: 144rpx; padding: 22rpx 0; border-bottom: 1rpx solid #e9ece7; width: 100%; text-align: left; }
.exercise-row:last-child { border: 0; }
.exercise-index { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 64rpx; height: 64rpx; font-size: 24rpx; color: #242823; background: #fff5c7; border-radius: 22rpx; }
.exercise-main { flex: 1; min-width: 0; font-size: 27rpx; font-weight: 700; color: #242823; }
.exercise-sub { display: block; font-size: 22rpx; font-weight: 400; color: #6e736f; margin-top: 8rpx; }
.exercise-row > image { width: 28rpx; height: 28rpx; opacity: .6; }
.progress-summary { display: flex; justify-content: space-around; padding: 40rpx 24rpx; background: #242823; border-color: #242823; }
.progress-summary > view { display: flex; flex-direction: column; align-items: center; gap: 10rpx; }
.progress-summary .meta { color: #c1c7b9; }
.progress-value { font-size: 56rpx; font-weight: 800; line-height: 1.25; color: #f8d849; }
.progress-course { width: 100%; text-align: left; padding: 32rpx; margin-top: 24rpx; }
.progress-course-top { display: flex; justify-content: space-between; font-size: 28rpx; font-weight: 700; gap: 24rpx; color: #242823; }
.progress-course-top text:last-child { color: #242823; }
.progress-track { height: 8rpx; background: #edf0ec; border-radius: 8rpx; overflow: hidden; margin: 24rpx 0 16rpx; }
.progress-track view { height: 100%; background: #f8d849; border-radius: 8rpx; }
