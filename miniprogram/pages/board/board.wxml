<view class="scene" aria-hidden="true"></view>
<view class="page board-page">
  <view wx:if="{{loading}}" class="skeleton-stack"><view class="skeleton skeleton-hero"></view><view class="skeleton skeleton-row"></view></view>
  <view wx:elif="{{error}}" class="empty-state surface-card"><text class="empty-title">暂时无法进入这个空间</text><text class="empty-copy">{{error}}</text><ui-button label="重新加载" size="small" bind:activate="retry" /><ui-button label="全部学习板块" variant="ghost" size="small" bind:activate="goLearn" /></view>
  <block wx:elif="{{board}}">
    <view class="board-intro"><view class="intro-badge"><image src="{{board.icon}}" /><text>{{board.badge || '学习空间'}}</text></view><text class="page-heading">{{board.title}}</text><text class="page-caption">{{board.description}}</text><view class="intro-stats"><text>{{board.courseCount}} 门课程</text><view></view><text>{{board.features.length}} 个学习入口</text></view></view>
    <view class="feature-grid"><button wx:for="{{board.features}}" wx:key="id" class="feature-card surface-card {{active === item.type ? 'is-active' : ''}}" data-type="{{item.type}}" bindtap="selectFeature" aria-label="{{item.title}}{{active === item.type ? '，已选择' : ''}}" hover-class="pressed"><view class="feature-icon"><image src="{{item.icon}}" /></view><text class="feature-title">{{item.title}}</text><text class="feature-description">{{item.description}}</text><view class="feature-indicator"></view></button></view>
    <block wx:if="{{active === 'courses'}}"><view class="section-bar"><view><text class="section-title">把学习连成一条路</text><text class="section-caption">从基础开始，逐步深入</text></view><text class="meta">{{courses.length}} 门课程</text></view><view wx:if="{{!courses.length}}" class="empty-state surface-card"><image src="/assets/icons/book.svg" /><text class="empty-title">课程正在准备中</text><text class="empty-copy">这个板块的课程发布后会出现在这里。</text></view><button wx:for="{{courses}}" wx:key="id" class="board-course surface-card" bindtap="openCourse" data-id="{{item.id}}" hover-class="pressed"><view class="board-course-cover"><image src="{{item.cover}}" mode="aspectFill" /><text class="course-state">{{item.accessible ? '已加入学习' : '课程介绍'}}</text></view><view class="board-course-body"><text class="board-course-title">{{item.title}}</text><text class="board-course-subtitle">{{item.subtitle}}</text><view class="board-course-foot"><text>{{item.lessons}} 章 · {{item.accessible ? '已完成 ' + item.progress + '%' : '查看学习内容'}}</text><view>查看课程<image src="/assets/icons/arrow.svg" /></view></view></view></button></block>
    <block wx:elif="{{active === 'practice'}}"><view class="section-bar"><view><text class="section-title">学一点，也练一点</text><text class="section-caption">来自当前板块已授权课程的真实练习</text></view></view><view wx:if="{{!exercises.length}}" class="empty-state surface-card"><image src="/assets/icons/pencil.svg" /><text class="empty-title">{{signedIn ? '还没有可练习的内容' : '登录后开始练习'}}</text><text class="empty-copy">{{signedIn ? '加入有随堂练习的课程后，就可以在这里集中练习。' : '学习记录和练习会跟随你的账号保存。'}}</text><ui-button wx:if="{{!signedIn}}" label="登录 / 兑换课程" size="small" bind:activate="login" /></view><view class="exercise-list surface-card"><button wx:for="{{exercises}}" wx:key="id" class="exercise-row" bindtap="openExercise" data-id="{{item.id}}" hover-class="pressed"><view class="exercise-index">{{index + 1}}</view><view class="exercise-main"><text>{{item.chapterTitle}}</text><text class="exercise-sub">{{item.courseTitle}} · {{item.title}}</text></view><image src="/assets/icons/arrow.svg" /></button></view></block>
    <block wx:elif="{{active === 'progress'}}"><view class="section-bar"><text class="section-title">你走过的每一步</text></view><view class="progress-summary surface-card"><view><text class="progress-value">{{progressCourses.length}}</text><text class="meta">已加入课程</text></view><view><text class="progress-value">{{completedCount}}</text><text class="meta">已完成章节</text></view></view><view wx:if="{{!progressCourses.length}}" class="empty-state surface-card"><text class="empty-title">从第一门课开始</text><text class="empty-copy">{{signedIn ? '兑换或获得课程授权后，这里会记录你的学习进展。' : '登录账号后，可以在不同设备上继续学习。'}}</text><ui-button label="登录 / 兑换课程" variant="secondary" size="small" bind:activate="login" /></view><button wx:for="{{progressCourses}}" wx:key="id" class="progress-course surface-card" data-id="{{item.id}}" bindtap="openCourse" hover-class="pressed"><view class="progress-course-top"><text>{{item.title}}</text><text>{{item.progress}}%</text></view><view class="progress-track"><view style="width:{{item.progress}}%"></view></view><text class="meta">已完成 {{item.completed.length}} / {{item.lessons}} 章 · 继续学习</text></button></block>
  </block>
</view>
