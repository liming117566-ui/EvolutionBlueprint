<view class="scene" aria-hidden="true"></view>
<view wx:if="{{loading || error || !course}}" class="page"><view wx:if="{{loading}}" class="state-card glass-card">正在验证权限并加载课程…</view><view wx:if="{{error}}" class="state-card glass-card"><text>{{error}}</text><button class="text-link" bindtap="retry">重新加载</button><button class="text-link" bindtap="redeem">登录 / 兑换课程</button><button class="text-link" bindtap="goCourses">返回课程目录</button></view></view>
<view wx:if="{{course}}" class="page lesson-page">
  <view class="lesson-topline"><text class="label">{{course.category}}</text><button class="text-link" bindtap="openCatalog">查看目录<image src="/assets/icons/book.svg" /></button></view>
  <view class="lesson-cover glass-card"><view class="lesson-cover-inner"><image class="cover" src="{{course.cover}}" mode="aspectFill" /></view><view class="media-status"><text>图文课程</text></view></view>
  <view wx:if="{{!course.chapters.length}}" class="state-card glass-card">课程暂未添加章节。</view>
  <view wx:if="{{chapterId}}" class="article-heading"><text class="article-index">第 {{active + 1}} 节 / 共 {{course.lessons}} 节</text><text class="page-heading">{{chapterTitle}}</text></view>
  <view wx:if="{{chapterId}}" id="section-directory" class="section-bar"><text class="section-title">本章小章节</text><text class="meta">共 {{sections.length}} 节</text></view>
  <view wx:if="{{chapterId && !sections.length}}" class="state-card glass-card">本章暂未添加小章节。</view>
  <view class="section-list glass-card"><button wx:for="{{sections}}" wx:key="id" class="chapter-row {{sectionActive === index ? 'is-current' : ''}}" data-id="{{item.id}}" bindtap="openSection" disabled="{{loading || saving}}" hover-class="pressed"><view class="chapter-index"><image wx:if="{{item.done}}" class="check-icon" src="/assets/icons/check.svg" /><text wx:else>{{index + 1}}</text></view><view class="chapter-main"><text class="chapter-name">{{item.title}}</text><text class="chapter-status">{{item.done ? '已完成，可再次阅读' : '点击阅读'}}</text></view><image class="section-arrow" src="/assets/icons/arrow.svg" /></button></view>
  <view wx:if="{{section}}" id="section-reader"><view class="section-bar"><text class="section-title">{{section.title}}</text><button class="text-link" bindtap="closeSection">返回小章节</button></view><view class="article-card glass-card"><text class="article-question">{{section.question}}</text><text wx:for="{{section.body}}" wx:key="*this" class="article-paragraph">{{item}}</text><view wx:if="{{section.practice}}" class="exercise"><text class="exercise-label">本节练习</text><text class="exercise-copy">{{section.practice}}</text></view></view><reading-materials scope="section" owner-id="{{section.id}}" /></view>
  <reading-materials wx:if="{{chapterId}}" scope="chapter" owner-id="{{chapterId}}" />
  <reading-materials id="reading-materials" scope="course" owner-id="{{course.id}}" />
  <view class="completion-note"><image src="/assets/icons/check.svg" /><text>{{completed ? '本章已完成，可以随时回看' : '完成各个小章节后，自动记录本章学习'}}</text></view>
</view>
<view wx:if="{{course}}" class="lesson-bottom"><view class="lesson-controls glass-card"><button class="catalog-button" bindtap="openCatalog"><image src="/assets/icons/book.svg" /><text>目录</text></button><view class="next-control"><ui-button size="small" label="{{saving ? '正在同步' : (!section ? '请选择一个小章节' : '完成小节，继续学习')}}" loading="{{saving}}" disabled="{{!section || loading}}" bind:activate="nextSection" /></view></view></view>
<ui-sheet visible="{{showCatalog}}" title="课程目录" bind:close="closeCatalog"><button wx:for="{{chapters}}" wx:key="id" class="chapter-row {{item.current ? 'is-current' : ''}}" data-id="{{item.id}}" bindtap="selectLesson" hover-class="pressed"><view class="chapter-index"><image wx:if="{{item.done}}" class="check-icon" src="/assets/icons/check.svg" /><text wx:else>{{index + 1}}</text></view><view class="chapter-main"><text class="chapter-name">{{item.title}}</text><text class="chapter-status">{{item.current ? '当前章节' : (item.done ? '已完成' : '图文课程')}}</text></view></button><ui-button slot="footer" label="返回全部课程" variant="secondary" bind:activate="goCourses" /></ui-sheet>
