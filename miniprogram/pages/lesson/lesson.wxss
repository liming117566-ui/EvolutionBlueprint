.lesson-page { padding-top: 12rpx; }
.lesson-topline { display: flex; justify-content: space-between; align-items: center; gap: 20rpx; margin-bottom: 20rpx; }
.lesson-topline .label { color: #242823; background: #fff5c7; border-radius: 12rpx; }
.lesson-topline .text-link { color: #6e736f; }
.lesson-topline image { width: 28rpx; height: 28rpx; }
.lesson-cover { padding: 0; overflow: hidden; border-radius: 40rpx; }
.lesson-cover-inner { position: relative; height: 330rpx; overflow: hidden; }
.media-status { display: flex; justify-content: space-between; padding: 20rpx 28rpx; color: #6e736f; font-size: 22rpx; }
.article-heading { margin: 36rpx 0 28rpx; }
.article-index { display: block; margin-bottom: 14rpx; font-size: 22rpx; color: #6e736f; }
.article-heading .page-heading { font-size: 44rpx; line-height: 1.4; font-weight: 800; color: #242823; }
.article-card { padding: 40rpx 32rpx; border-radius: 40rpx; }
.article-question { display: block; margin-bottom: 28rpx; font-size: 34rpx; line-height: 1.65; font-weight: 800; color: #242823; }
.article-paragraph { display: block; margin-bottom: 28rpx; color: #525a4f; font-size: 29rpx; line-height: 1.95; }
.article-paragraph:last-child { margin-bottom: 0; }
.exercise { margin-top: 36rpx; padding: 28rpx; border-radius: 28rpx; background: #fff5c7; border: 1px solid #f8d849; }
.exercise-label { display: block; margin-bottom: 12rpx; color: #242823; font-size: 23rpx; font-weight: 800; }
.exercise-copy { display: block; font-size: 27rpx; line-height: 1.85; color: #242823; }
.completion-note { display: flex; align-items: center; justify-content: center; gap: 12rpx; margin-top: 32rpx; color: #6e736f; font-size: 22rpx; }
.completion-note image, .check-icon { width: 28rpx; height: 28rpx; }
.lesson-bottom { position: fixed; z-index: 100; left: 32rpx; right: 32rpx; bottom: 20rpx; bottom: calc(20rpx + env(safe-area-inset-bottom)); }
.lesson-controls { display: flex; gap: 16rpx; align-items: center; padding: 14rpx 16rpx; border-radius: 999rpx; background: rgba(255,255,255,.92); border-color: #ffffff; box-shadow: 0 8rpx 32rpx rgba(36,40,35,.09); backdrop-filter: blur(22px); -webkit-backdrop-filter: blur(22px); }
.catalog-button { display: flex; align-items: center; justify-content: center; gap: 12rpx; flex-shrink: 0; min-width: 120rpx; min-height: 88rpx; color: #242823; font-size: 24rpx; font-weight: 700; }
.catalog-button image { width: 30rpx; height: 30rpx; }
.next-control { flex: 1; min-width: 0; }
.section-arrow { flex-shrink: 0; width: 28rpx; height: 28rpx; opacity: .6; }
.section-list { padding: 0 28rpx; border-radius: 40rpx; }
.section-list .chapter-row { min-height: 132rpx; padding: 24rpx 0; gap: 20rpx; border-color: #e9ece7; }
.section-list .chapter-index { width: 64rpx; height: 64rpx; border-radius: 22rpx; background: #e7efe8; color: #6e736f; }
.section-list .chapter-name { color: #242823; font-size: 27rpx; font-weight: 700; }
.section-list .chapter-status { color: #6e736f; font-size: 22rpx; margin-top: 8rpx; }
.section-list .is-current .chapter-index { color: #242823; background: #f8d849; }
.section-list .is-current .chapter-name { color: #242823; }
#section-reader { margin-top: 32rpx; }
