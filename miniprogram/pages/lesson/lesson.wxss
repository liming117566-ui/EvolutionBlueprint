.lesson-page { padding-top: 6rpx; }
.lesson-topline { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.lesson-topline image { width: 28rpx; height: 28rpx; }
.lesson-cover { padding: 10rpx; border-radius: 34rpx; }
.lesson-cover-inner { position: relative; height: 300rpx; border-radius: 26rpx; overflow: hidden; }
.media-preview { position: absolute; left: 50%; top: 50%; display: flex; align-items: center; gap: 12rpx; min-height: 88rpx; padding: 16rpx 28rpx; border-radius: 999rpx; background: rgba(255,255,255,.15); border: 1px solid rgba(255,255,255,.75); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); color: #191a1d; font-size: 23rpx; transform: translate(-50%, -50%); white-space: nowrap; }
.media-preview image { width: 27rpx; height: 27rpx; }
.media-status { display: flex; justify-content: space-between; padding: 16rpx 12rpx 8rpx; color: var(--muted); font-size: 21rpx; }
.article-heading { margin: 34rpx 0 26rpx; }
.article-index { display: block; margin-bottom: 12rpx; font-size: 22rpx; color: var(--muted); }
.article-heading .page-heading { font-size: 43rpx; }
.article-card { padding: 32rpx 28rpx; border-radius: 32rpx; }
.article-question { display: block; margin-bottom: 24rpx; font-size: 30rpx; line-height: 1.65; font-weight: 600; }
.article-paragraph { display: block; margin-bottom: 24rpx; color: rgba(25,26,29,.82); font-size: 28rpx; line-height: 1.95; }
.exercise { margin-top: 32rpx; padding: 24rpx; border-radius: 22rpx; background: rgba(20,63,50,.055); border: 1px solid rgba(255,255,255,.6); }
.exercise-label { display: block; margin-bottom: 10rpx; color: #143f32; font-size: 22rpx; font-weight: 500; }
.exercise-copy { display: block; font-size: 26rpx; line-height: 1.75; }
.completion-note { display: flex; align-items: center; justify-content: center; gap: 10rpx; margin-top: 30rpx; color: var(--muted); font-size: 22rpx; }
.completion-note image, .check-icon { width: 28rpx; height: 28rpx; }
.demo-note { display: block; margin-top: 16rpx; text-align: center; color: rgba(25,26,29,.52); font-size: 20rpx; }
.lesson-bottom { position: fixed; z-index: 100; left: 32rpx; right: 32rpx; bottom: 20rpx; bottom: calc(20rpx + env(safe-area-inset-bottom)); }
.lesson-controls { display: flex; gap: 20rpx; align-items: center; padding: 12rpx 16rpx; border-radius: 999rpx; }
.catalog-button { display: flex; align-items: center; justify-content: center; gap: 10rpx; flex-shrink: 0; min-width: 126rpx; min-height: 84rpx; color: #191a1d; font-size: 23rpx; }
.catalog-button image { width: 29rpx; height: 29rpx; }
.next-control { flex: 1; }
.section-arrow { flex-shrink: 0; width: 26rpx; height: 26rpx; }
.section-list { padding: 6rpx 24rpx; border-radius: 28rpx; }
#section-reader { margin-top: 28rpx; }
