<web-view wx:if="{{src}}" src="{{src}}" bindload="onWebLoad" binderror="onWebError"></web-view>
<block wx:else><view class="scene" aria-hidden="true"></view><view class="page module-host"><view wx:if="{{loading}}" class="empty-state surface-card"><image src="/assets/icons/book.svg" /><text class="empty-title">正在打开{{title}}</text><text class="empty-copy">准备学习内容…</text></view><view wx:elif="{{error}}" class="empty-state surface-card"><text class="empty-title">暂时无法打开</text><text class="empty-copy">{{error}}</text><ui-button label="重新加载" size="small" bind:activate="retry" /><ui-button label="其他学习板块" variant="ghost" size="small" bind:activate="goLearn" /></view></view></block>
