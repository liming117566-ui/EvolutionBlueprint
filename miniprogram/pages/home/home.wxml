<view class="scene" aria-hidden="true"></view>
<view class="page home-page">
  <view class="home-header"><view class="brand"><image src="{{settings.logo}}" /><text>{{settings.brandName}}</text></view><button class="avatar-button" bindtap="goProfile" aria-label="我的账户" hover-class="pressed"><image src="{{settings.avatar}}" /></button></view>
  <view class="welcome"><text class="eyebrow">{{dateLabel}}</text><text class="page-heading">{{settings.welcomeTitle}}</text><text class="page-caption">找到感兴趣的方向，让每次打开都有收获。</text></view>
  <view wx:if="{{loading}}" class="skeleton-stack" aria-label="正在加载学习板块"><view class="skeleton skeleton-hero"></view><view class="skeleton skeleton-line"></view><view class="skeleton skeleton-hero"></view></view>
  <view wx:elif="{{error}}" class="empty-state surface-card"><image src="/assets/icons/book.svg" /><text class="empty-title">暂时没有连接上</text><text class="empty-copy">{{error}}</text><ui-button size="small" label="重新加载" bind:activate="retry" /></view>
  <block wx:else>
    <button wx:if="{{featured}}" class="spotlight pressable tone--{{featured.tone}}" bindtap="openFeatured" hover-class="pressed" aria-label="进入{{featured.title}}">
      <view class="spotlight-top"><view class="spotlight-badge"><view></view><text>{{featured.badge || '精选学习空间'}}</text></view><text class="spotlight-number">循序渐进 · 持续生长</text></view>
      <view class="spotlight-body"><view class="spotlight-copy"><text class="spotlight-title">{{featured.title}}</text><text class="spotlight-subtitle">{{featured.subtitle}}</text><view class="spotlight-action">进入学习空间<image src="/assets/icons/arrow.svg" /></view></view><image class="spotlight-art" src="{{featured.cover}}" mode="aspectFill" /></view>
      <view class="spotlight-foot"><text>{{featured.metaLabel || (featured.courseCount ? featured.courseCount + ' 门系统课程' : '课程内容筹备中')}}</text><text>{{featured.featureLabel}}</text></view>
    </button>
    <view class="section-bar"><view><text class="section-title">探索学习板块</text><text class="section-caption">从兴趣出发，找到适合你的路径</text></view><button class="subtle-action" bindtap="goLearn" aria-label="查看全部学习板块">全部<image src="/assets/icons/arrow.svg" /></button></view>
    <view wx:if="{{!boards.length}}" class="empty-state surface-card"><text class="empty-title">新的学习空间正在准备</text><text class="empty-copy">发布后，板块会出现在这里。</text></view>
    <view class="board-grid"><board-card wx:for="{{boards}}" wx:key="id" board="{{item}}" bind:open="openBoard" /></view>
    <button wx:if="{{continuing}}" class="resume-card surface-card" bindtap="continueCourse" hover-class="pressed"><view class="resume-icon"><image src="/assets/icons/play.svg" /></view><view class="resume-content"><text class="eyebrow">继续上次的学习</text><text class="resume-title">{{continuing.title}}</text></view><text class="resume-progress">{{continuing.progress}}%</text><image class="small-arrow" src="/assets/icons/arrow.svg" /></button>
    <view class="page-endnote"><view></view><text>每一点积累，都算数</text><view></view></view>
  </block>
</view>
<glass-nav id="main-nav" active="home" settings="{{settings}}" />
