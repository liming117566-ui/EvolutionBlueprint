<view class="page home-page">
  <view class="brand-bar" style="height:{{chrome.height}}px;padding-top:{{chrome.top}}px"><image src="{{settings.logo}}"/><text>{{settings.brandName}}</text></view>
  <view class="greeting"><view><text class="greeting-title">嗨，今天想学点什么？</text><text class="greeting-copy">每天一刻，让成长悄悄发生。</text></view><button class="checkin" bindtap="checkin" aria-label="今日学习打卡"><image src="/assets/icons/ui-sun.svg"/><text>{{stats.checked ? '已打卡' : '去打卡'}}</text></button></view>
  <view class="search-box"><image src="/assets/icons/ui-search.svg"/><input value="{{query}}" bindinput="search" bindconfirm="searchCourses" placeholder="搜索感兴趣的课程" confirm-type="search" maxlength="80" aria-label="搜索感兴趣的课程"/><button wx:if="{{query}}" bindtap="searchCourses">搜索</button></view>
  <view class="daily-hero"><view class="hero-copy"><text class="hero-eyebrow">— A LITTLE EVERY DAY</text><text class="hero-title">今天，也要
向前一点点</text><text class="hero-caption">从一节好课，开启新的可能</text><button class="hero-button" bindtap="goInteractive">探索好课<image src="/assets/icons/ui-arrow.svg"/></button></view><view class="hero-art" aria-hidden="true"><view class="paper-book"><text>ONE
STEP.</text><image src="/assets/icons/ui-sun.svg"/><view></view></view></view></view>
  <view class="quick-links"><button bindtap="goInteractive"><view class="quick-icon warm"><image src="/assets/icons/ui-screen.svg"/></view><text>互动学习</text></button><button bindtap="goResources"><view class="quick-icon mint"><image src="/assets/icons/ui-file.svg"/></view><text>电子资料</text></button><button bindtap="goPractice"><view class="quick-icon blue"><image src="/assets/icons/ui-pencil.svg"/></view><text>练习自测</text></button><button bindtap="goPlan"><view class="quick-icon violet"><image src="/assets/icons/ui-calendar.svg"/></view><text>学习计划</text></button></view>
  <view wx:if="{{loading}}" class="skeleton-stack"><view class="skeleton skeleton-row"></view><view class="skeleton skeleton-hero"></view></view>
  <view wx:elif="{{error}}" class="empty-state surface-card"><text class="empty-title">暂时没有连接上</text><text class="empty-copy">{{error}}</text><ui-button size="small" label="重新加载" bind:activate="retry"/></view>
  <block wx:else>
    <view class="section-bar"><text class="section-title">继续学习</text><button class="subtle-action" bindtap="goLearn">学习中心<image src="/assets/icons/ui-right.svg"/></button></view>
    <button wx:if="{{continuing}}" class="continue-card" bindtap="continueCourse" hover-class="pressed"><view class="continue-top"><image class="continue-cover" src="{{continuing.cover}}" mode="aspectFill"/><view class="continue-copy"><text>{{continuing.title}}</text><text class="meta">{{continuing.completed.length ? '已完成 ' + continuing.completed.length + ' 节' : '从上次停下的地方继续'}}</text></view><view class="play-small"><image src="/assets/icons/ui-play.svg"/></view></view><view class="progress-row"><view class="progress-track"><view style="width:{{continuing.progress}}%"></view></view><text>{{continuing.progress}}%</text></view></button>
    <button wx:else class="continue-empty" bindtap="goInteractive"><view class="quick-icon mint"><image src="/assets/icons/ui-book.svg"/></view><view><text class="continue-empty-title">从一节好课开始</text><text class="meta">找到喜欢的方向，留下第一步足迹</text></view><view class="play-small"><image src="/assets/icons/ui-play.svg"/></view></button>
    <view class="section-bar"><text class="section-title">为你精选</text><button class="subtle-action" bindtap="goInteractive">全部课程<image src="/assets/icons/ui-right.svg"/></button></view>
    <view class="filter-tabs"><button wx:for="{{groups}}" wx:key="id" class="filter-tab {{group === item.id ? 'is-active' : ''}}" data-id="{{item.id}}" bindtap="selectGroup">{{item.title}}</button></view>
    <view class="board-grid"><board-card wx:for="{{recommendations}}" wx:key="id" board="{{item}}" bind:open="openBoard"/></view>
    <view wx:if="{{!recommendations.length}}" class="empty-state"><text class="empty-copy">这个分类正在准备，试试其他学习方向。</text></view>
    <text class="footnote">保持好奇，进步自然发生。</text>
  </block>
</view><glass-nav id="main-nav" active="home" settings="{{settings}}"/>
