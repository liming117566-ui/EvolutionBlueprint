.greeting{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin:14rpx 0 38rpx}.greeting-title{display:block;font-size:45rpx;line-height:1.4;font-weight:800;letter-spacing:-1.5rpx;white-space:nowrap}.greeting-copy{display:block;font-size:24rpx;color:#6e736f;margin-top:9rpx}.checkin{display:flex;flex-direction:column;align-items:center;gap:6rpx;min-width:90rpx;font-size:20rpx;color:#6e736f}.checkin>image{width:48rpx;height:48rpx}.daily-hero{display:flex;align-items:center;background:#f8d849;border-radius:40rpx;padding:38rpx;gap:10rpx;min-height:380rpx}.hero-copy{flex:1;min-width:0}.hero-eyebrow{display:block;font-size:18rpx;letter-spacing:3rpx;font-weight:750;white-space:nowrap}.hero-title{display:block;white-space:pre-line;font-size:50rpx;line-height:1.35;font-weight:800;letter-spacing:-1.6rpx;margin-top:14rpx}.hero-caption{display:block;color:#60571e;font-size:22rpx;margin:14rpx 0 26rpx;white-space:nowrap}.hero-button{display:flex;align-items:center;gap:24rpx;padding:12rpx 24rpx;min-height:62rpx;border-radius:40rpx;background:#242823;color:#fff;font-size:22rpx;font-weight:700;width:max-content}.hero-button>image{width:30rpx;height:30rpx;filter:brightness(0) invert(1)}.hero-art{display:flex;align-items:center;justify-content:center;width:192rpx;flex-shrink:0}.paper-book{width:154rpx;height:205rpx;padding:20rpx 16rpx;background:#fcfff2;color:#242823;border-radius:6rpx 22rpx 22rpx 6rpx;border-left:14rpx solid #d1dc99;box-shadow:14rpx 14rpx 0 #cfb42f;transform:rotate(-12deg);display:flex;flex-direction:column;justify-content:space-between}.paper-book>text{white-space:pre-line;font-family:Georgia,serif;font-size:48rpx;line-height:1;font-weight:800;letter-spacing:-2rpx}.paper-book>image{width:40rpx;height:40rpx}.paper-book>view{width:74rpx;height:10rpx;border-top:1rpx solid #889476;border-bottom:1rpx solid #889476}.quick-links{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14rpx;margin:46rpx 0}.quick-links>button{display:flex;flex-direction:column;align-items:center;gap:14rpx;font-size:23rpx;min-height:136rpx}.quick-icon{display:flex;align-items:center;justify-content:center;width:84rpx;height:84rpx;border-radius:27rpx;flex-shrink:0}.quick-icon>image{width:43rpx;height:43rpx}.warm{background:#f3ecd3}.mint{background:#e4ece4}.blue{background:#e7ecf3}.violet{background:#eee8ee}.continue-card,.continue-empty{display:block;width:100%;padding:30rpx;background:#fff;border:1rpx solid #e9ece7;border-radius:40rpx;text-align:left}.continue-top,.continue-empty{display:flex;align-items:center;gap:22rpx}.continue-cover{width:116rpx;height:128rpx;border-radius:20rpx;flex-shrink:0}.continue-copy{flex:1;min-width:0}.continue-copy>text:first-child{display:block;font-size:28rpx;font-weight:700;margin-bottom:8rpx}.play-small{display:flex;align-items:center;justify-content:center;background:#f8d849;width:68rpx;height:68rpx;border-radius:50%;flex-shrink:0}.play-small>image{width:32rpx;height:32rpx}.continue-empty>view:nth-child(2){flex:1;min-width:0}.continue-empty-title{display:block;font-size:28rpx;font-weight:700;margin-bottom:6rpx}.progress-row{display:flex;align-items:center;gap:20rpx;font-size:20rpx;color:#6e736f;margin-top:22rpx}.progress-track{flex:1;height:8rpx;background:#edf0ec;border-radius:8rpx;overflow:hidden}.progress-track>view{height:100%;background:#8e9e6e}
@media(max-width:374px){.greeting-title{font-size:41rpx}.daily-hero{padding:30rpx}.hero-art{width:162rpx}.hero-title{font-size:46rpx}.hero-caption{font-size:20rpx}}
.home-banners { height: 400rpx; border-radius: 40rpx; overflow: hidden; }
.home-banners .daily-hero { height: 100%; box-sizing: border-box; padding-bottom: 66rpx; }
.print-hero { background: #dcebdc; }
.print-hero .hero-title { margin-top: 0; }
.print-hero .hero-caption { color: #475846; }
.print-illustration { position: relative; width: 158rpx; height: 186rpx; transform: rotate(-9deg); }
.print-paper, .printed-sheet { position: absolute; left: 35rpx; width: 88rpx; background: #fafff4; border-radius: 9rpx; }
.print-paper { top: 0; height: 92rpx; box-shadow: 10rpx 0 #c0d3bf; }
.print-machine { position: absolute; top: 50rpx; left: 0; right: 0; height: 98rpx; border-radius: 24rpx; background: #526a52; box-shadow: 8rpx 9rpx #b1c4af; }
.print-light { position: absolute; top: 17rpx; right: 19rpx; height: 10rpx; width: 10rpx; border-radius: 50%; background: #f8d849; }
.print-slot { position: absolute; top: 48rpx; left: 20rpx; right: 20rpx; height: 17rpx; border-radius: 12rpx; background: #344633; }
.printed-sheet { top: 107rpx; height: 74rpx; box-shadow: 6rpx 6rpx #c0d3bf; }
.printed-sheet::after { content: ''; position: absolute; top: 20rpx; left: 18rpx; right: 18rpx; height: 17rpx; border-top: 3rpx solid #9ab198; border-bottom: 3rpx solid #9ab198; }
.greeting-copy-wrap { min-width: 0; }
.greeting-copy-wrap .greeting-title { white-space: normal; font-size: 40rpx; }
.greeting-actions { display: flex; flex: 0 0 auto; gap: 6rpx; }
.greeting-actions .checkin { position: relative; min-width: 70rpx; }
.announcement-dot { position: absolute; width: 12rpx; height: 12rpx; top: 2rpx; right: 8rpx; border-radius: 50%; background: #bd5c24; }
.announcement-body { display: block; font-size: 28rpx; line-height: 1.7; overflow-wrap: break-word; }
