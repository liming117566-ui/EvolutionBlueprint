.home-page{padding-top:12rpx}.home-header{display:flex;justify-content:space-between;align-items:center}.brand{display:flex;align-items:center;gap:14rpx;font-size:28rpx;font-weight:600;letter-spacing:1rpx}.brand image{width:52rpx;height:52rpx}.avatar-button{display:flex;align-items:center;justify-content:center;width:72rpx;height:72rpx;border:1rpx solid rgba(25,26,29,.06);border-radius:50%;background:rgba(255,255,255,.8)}.avatar-button image{width:33rpx;height:33rpx}.welcome{margin:42rpx 0 32rpx}.welcome .page-heading{margin-top:14rpx;font-size:46rpx;letter-spacing:-1.5rpx}.welcome .page-caption{font-size:24rpx;margin-top:14rpx}.spotlight{display:block;width:100%;overflow:hidden;text-align:left;border:1px solid rgba(255,255,255,.95);border-radius:32rpx;background:linear-gradient(125deg,rgba(255,255,255,.94),rgba(233,238,235,.23));box-shadow:0 12rpx 30rpx rgba(20,63,50,.05);padding:28rpx 28rpx 0}.spotlight-top{display:flex;align-items:center;justify-content:space-between}.spotlight-badge{display:flex;align-items:center;gap:10rpx;color:#143f32;font-size:21rpx;font-weight:500}.spotlight-badge view{width:8rpx;height:8rpx;background:#143f32;border-radius:50%}.spotlight-number{font-size:18rpx;color:rgba(25,26,29,.4)}.spotlight-body{position:relative;display:flex;min-height:270rpx;align-items:center}.spotlight-copy{position:relative;z-index:1;width:62%;padding:24rpx 0}.spotlight-title{display:block;font-size:48rpx;font-weight:600;letter-spacing:-1rpx}.spotlight-subtitle{display:block;max-width:250rpx;margin-top:12rpx;font-size:23rpx;line-height:1.8;color:rgba(25,26,29,.6)}.spotlight-action{display:inline-flex;align-items:center;gap:14rpx;margin-top:25rpx;color:#143f32;font-size:23rpx;font-weight:500}.spotlight-action image{width:26rpx;height:26rpx}.spotlight-art{position:absolute;right:-42rpx;top:18rpx;width:310rpx;height:240rpx;border-radius:28rpx;transform:rotate(-7deg);box-shadow:0 14rpx 28rpx rgba(20,63,50,.05)}.spotlight-foot{display:flex;justify-content:space-between;align-items:center;border-top:1rpx solid rgba(25,26,29,.055);padding:19rpx 0;color:rgba(25,26,29,.5);font-size:21rpx}.board-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20rpx}.resume-card{display:flex;align-items:center;gap:20rpx;padding:26rpx;margin-top:26rpx;width:100%;text-align:left}.resume-icon{display:flex;align-items:center;justify-content:center;width:66rpx;height:66rpx;background:rgba(20,63,50,.07);border-radius:20rpx}.resume-icon image{width:28rpx;height:28rpx}.resume-content{flex:1;min-width:0}.resume-content .eyebrow{font-size:19rpx}.resume-title{display:block;font-weight:500;font-size:25rpx;margin-top:7rpx}.resume-progress{font-size:25rpx;color:#143f32}@media(max-width:350px){.spotlight-number{display:none}.spotlight-art{right:-72rpx;width:280rpx;opacity:.8}.spotlight-copy{width:66%}.spotlight-title{font-size:44rpx}}
.spotlight { background: #143f32; border-color: rgba(20,63,50,.12); box-shadow: 0 12rpx 30rpx rgba(20,63,50,.1); }
.spotlight-title, .spotlight-action, .spotlight-badge { color: #ffffff; }
.spotlight-subtitle, .spotlight-foot { color: rgba(255,255,255,.78); }
.spotlight-number { color: rgba(255,255,255,.55); }
.spotlight-foot { border-top-color: rgba(255,255,255,.16); }
.spotlight-badge view { background: rgba(255,255,255,.9); }
.spotlight-action image { filter: brightness(0) invert(1); }
