.home-page { padding-top: 16rpx; }
.home-header { display: flex; align-items: center; justify-content: space-between; }
.brand { display: flex; align-items: center; gap: 16rpx; font-size: 29rpx; font-weight: 600; letter-spacing: 1rpx; }
.brand-mark { width: 60rpx; height: 60rpx; }
.profile-shortcut { display: flex; align-items: center; justify-content: center; width: 80rpx; height: 80rpx; border-radius: 50%; }
.profile-shortcut image { width: 34rpx; height: 34rpx; }
.welcome { display: flex; align-items: flex-end; justify-content: space-between; gap: 12rpx; margin-top: 42rpx; }
.welcome-date { display: block; margin-bottom: 10rpx; color: var(--muted); font-size: 24rpx; }
.welcome .page-heading { font-size: 45rpx; }
.access-label { flex-shrink: 0; display: flex; align-items: center; gap: 8rpx; margin-bottom: 6rpx; color: rgba(23,43,67,.68); font-size: 19rpx; }
.access-label view { width: 8rpx; height: 8rpx; border-radius: 50%; background: #416bf0; }
.section-bar { margin-top: 32rpx; margin-bottom: 16rpx; }
.text-link image { width: 24rpx; height: 24rpx; opacity: .6; }
.featured-card { padding: 12rpx; overflow: hidden; }
.featured-cover { position: relative; height: 302rpx; overflow: hidden; border-radius: 30rpx; background: rgba(65,107,240,.045); }
.cover-label { position: absolute; left: 22rpx; top: 22rpx; padding: 8rpx 18rpx; border: 1px solid rgba(255,255,255,.7); border-radius: 999rpx; background: rgba(255,255,255,.15); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); color: #172b43; font-size: 21rpx; }
.cover-play { position: absolute; right: 22rpx; bottom: 22rpx; display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; border: 1px solid rgba(255,255,255,.75); border-radius: 50%; background: rgba(255,255,255,.15); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); }
.cover-play image { width: 29rpx; height: 29rpx; }
.featured-body { padding: 24rpx 16rpx 12rpx; }
.featured-title-row { display: flex; justify-content: space-between; align-items: center; }
.featured-title { font-size: 35rpx; font-weight: 600; letter-spacing: -.6rpx; }
.lesson-count { color: var(--muted); font-size: 23rpx; }
.featured-subtitle { display: block; margin-top: 8rpx; color: var(--muted); font-size: 25rpx; }
.featured-footer { display: flex; justify-content: space-between; align-items: center; margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid var(--line); }
.course-action { display: flex; align-items: center; gap: 6rpx; font-size: 24rpx; color: #416bf0; font-weight: 500; }
.course-action image { width: 23rpx; height: 23rpx; }
.more-heading { margin-top: 32rpx; margin-bottom: 22rpx; }
.more-heading .meta { font-size: 22rpx; }
.course-grid { display: flex; gap: 20rpx; }
.course-card { flex: 1; min-width: 0; padding: 10rpx; border-radius: 30rpx; overflow: hidden; }
.course-cover { width: 100%; height: 186rpx; overflow: hidden; border-radius: 22rpx; background: rgba(183,173,235,.12); }
.course-body { padding: 18rpx 10rpx 12rpx; }
.course-title { display: block; font-size: 28rpx; font-weight: 600; line-height: 1.4; }
.course-subtitle { display: block; margin-top: 9rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: var(--muted); font-size: 21rpx; }
.course-bottom { display: flex; justify-content: space-between; margin-top: 20rpx; color: var(--muted); font-size: 20rpx; }
.home-note { display: flex; align-items: center; justify-content: center; gap: 16rpx; margin-top: 40rpx; color: rgba(23,43,67,.54); font-size: 21rpx; }
.home-note view { width: 30rpx; height: 1rpx; background: rgba(23,43,67,.14); }
.preview-cover { height: 240rpx; overflow: hidden; border-radius: 26rpx; }
.preview-meta { display: flex; align-items: center; justify-content: space-between; margin: 22rpx 0 16rpx; }
.preview-description { display: block; font-size: 25rpx; color: rgba(23,43,67,.8); line-height: 1.8; }
.preview-heading { display: block; margin-top: 26rpx; font-size: 28rpx; font-weight: 600; }
.chapter-check { width: 30rpx; height: 30rpx; }
@media (max-width: 350px) { .access-label { display: none; } .welcome .page-heading { font-size: 42rpx; } }
