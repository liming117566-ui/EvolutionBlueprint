<view class="scene" aria-hidden="true"></view><view class="page course-detail-page">
<view wx:if="{{loading}}" class="skeleton-stack"><view class="skeleton skeleton-hero"></view><view class="skeleton skeleton-row"></view></view>
<view wx:elif="{{error}}" class="empty-state surface-card"><text class="empty-title">课程暂时无法加载</text><text class="empty-copy">{{error}}</text><ui-button label="重试" size="small" bind:activate="retry" /></view>
<block wx:elif="{{current}}"><view class="detail-cover"><image src="{{current.cover}}" mode="aspectFill" /></view><view class="course-intro"><text class="label">{{current.category}}</text><text class="page-heading">{{current.title}}</text><text class="page-caption">{{current.subtitle}}</text><view class="detail-meta"><text>{{current.lessons}} 章课程</text><text>{{current.accessible ? '已完成 ' + current.progress + '%' : '按章节循序学习'}}</text></view></view><view class="detail-about surface-card"><text class="section-title">关于这门课</text><text class="detail-description">{{current.description}}</text><text wx:if="{{current.duration}}" class="detail-duration">{{current.duration}}</text></view>
<view class="section-bar"><text class="section-title">课程目录</text><text class="meta">{{current.lessons}} 章</text></view><view wx:if="{{!current.accessible}}" class="empty-state surface-card"><image src="/assets/icons/book.svg" /><text class="empty-title">加入课程，开启学习</text><text class="empty-copy">登录并兑换此课程后，可以阅读章节、参与练习并同步学习进度。</text></view><view wx:else class="detail-chapters surface-card"><button wx:for="{{chapters}}" wx:key="id" class="chapter-row" bindtap="openChapter" data-id="{{item.id}}" hover-class="pressed"><view class="chapter-index"><image wx:if="{{item.done}}" src="/assets/icons/check.svg" /><text wx:else>{{index + 1}}</text></view><view class="chapter-main"><text class="chapter-name">{{item.title}}</text><text class="chapter-status">{{item.done ? '已完成 · 可再次阅读' : '阅读与随堂练习'}}</text></view><image class="small-arrow" src="/assets/icons/arrow.svg" /></button></view><view class="course-bottom-action"><ui-button label="{{current.accessible ? (current.progress ? '继续学习' : '开始学习') : '登录 / 兑换此课程'}}" bind:activate="start" /></view></block>
</view>
