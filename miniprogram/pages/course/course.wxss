.course-detail-page{padding-top:12rpx;padding-bottom:70rpx}.detail-cover{height:330rpx;overflow:hidden;border-radius:30rpx;border:1rpx solid rgba(255,255,255,.9)}.detail-cover image{width:100%;height:100%}.course-intro{padding:32rpx 0}.course-intro .page-heading{margin-top:20rpx;font-size:44rpx}.course-intro .page-caption{font-size:24rpx}.detail-meta{display:flex;justify-content:space-between;color:rgba(25,26,29,.5);font-size:22rpx;margin-top:26rpx}.detail-about{padding:30rpx}.detail-about .section-title{font-size:28rpx}.detail-description{display:block;margin-top:18rpx;font-size:25rpx;color:rgba(25,26,29,.68);line-height:1.95}.detail-duration{display:block;margin-top:22rpx;font-size:22rpx;color:#143f32}.detail-chapters{padding:4rpx 26rpx}.chapter-index image{width:28rpx;height:28rpx}.course-bottom-action{margin-top:32rpx}
