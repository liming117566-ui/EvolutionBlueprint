.course-detail-page { padding-top: 12rpx; padding-bottom: 80rpx; }
.detail-cover { height: 354rpx; overflow: hidden; border-radius: 40rpx; background: #e7efe8; }
.detail-cover image { width: 100%; height: 100%; }
.course-intro { padding: 32rpx 0; }
.course-intro .label { color: #242823; background: #fff5c7; border-radius: 12rpx; }
.course-intro .page-heading { margin-top: 24rpx; font-size: 46rpx; font-weight: 800; line-height: 1.4; letter-spacing: -1rpx; }
.course-intro .page-caption { font-size: 26rpx; line-height: 1.8; color: #6e736f; }
.detail-meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12rpx; color: #6e736f; font-size: 22rpx; margin-top: 26rpx; }
.detail-about { padding: 32rpx; border-radius: 40rpx; }
.detail-about .section-title { font-size: 30rpx; font-weight: 800; }
.detail-description { display: block; margin-top: 20rpx; font-size: 27rpx; color: #6e736f; line-height: 1.85; }
.detail-duration { display: inline-block; margin-top: 24rpx; padding: 8rpx 16rpx; border-radius: 12rpx; background: #e7efe8; font-size: 22rpx; color: #242823; }
.detail-chapters { padding: 0 32rpx; border-radius: 40rpx; }
.detail-chapters .chapter-row { min-height: 144rpx; padding: 24rpx 0; gap: 24rpx; border-color: #e9ece7; }
.detail-chapters .chapter-index { width: 64rpx; height: 64rpx; border-radius: 22rpx; color: #6e736f; background: #e7efe8; }
.chapter-index image { width: 30rpx; height: 30rpx; }
.detail-chapters .chapter-name { font-size: 27rpx; font-weight: 700; color: #242823; }
.detail-chapters .chapter-status { margin-top: 8rpx; font-size: 22rpx; color: #6e736f; }
.course-bottom-action { margin-top: 32rpx; }
