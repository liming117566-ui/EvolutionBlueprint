<view class="page profile-page">
  <view class="brand-bar" style="height:{{chrome.height}}px;padding-top:{{chrome.top}}px"><image src="{{settings.logo}}"/><text>{{settings.brandName}}</text></view>
  <view wx:if="{{loading}}" class="state-card surface-card">正在读取账号与学习记录…</view><view wx:if="{{error}}" class="state-card surface-card"><text>{{error}}</text><button class="text-link" bindtap="retry">重试</button></view>
  <view class="profile"><view class="profile-avatar"><image src="{{settings.avatar}}"/></view><view class="profile-main"><text class="profile-name">{{user.nickname || '正在读取用户名…'}}</text><text class="profile-copy">保持热爱，慢慢变厉害。</text><text class="profile-tag">{{testSession ? '测试模式 · 当前设备账号' : '终身学习进行中'}}</text></view><button class="icon-button" data-type="help" bindtap="showInfo" aria-label="使用帮助"><image src="/assets/icons/ui-settings.svg"/></button></view>
  <view class="stats-card"><view><text class="stat-number">{{stats.activeDays}}</text><text>学习天数</text></view><view><text class="stat-number">{{stats.completed}}</text><text>完成章节</text></view><view><text class="stat-number">{{stats.unlocked}}</text><text>解锁板块</text></view></view>
  <button class="goal-banner" bindtap="goPlan"><image src="/assets/icons/ui-flag.svg"/><view><text class="goal-title">每天 {{stats.goal}} 分钟的小目标</text><text class="goal-copy">给学习留点时间，给自己一点期待</text></view><image class="row-arrow" src="/assets/icons/ui-right.svg"/></button>
  <view class="section-bar"><text class="section-title">我的学习</text></view>
  <view class="menu-list"><button class="menu-row" bindtap="toggleRecords"><image src="/assets/icons/ui-book.svg"/><text class="menu-label">学习记录</text><text class="menu-count">{{stats.completed}} 节</text><image class="row-arrow" src="/assets/icons/ui-right.svg"/></button><button class="menu-row" bindtap="goUnlocked"><image src="/assets/icons/ui-star.svg"/><text class="menu-label">已解锁课程</text><text class="menu-count">{{stats.unlocked}}</text><image class="row-arrow" src="/assets/icons/ui-right.svg"/></button><button class="menu-row" bindtap="goResources"><image src="/assets/icons/ui-file.svg"/><text class="menu-label">电子资料</text><image class="row-arrow" src="/assets/icons/ui-right.svg"/></button><button class="menu-row" bindtap="goNotes"><image src="/assets/icons/ui-pencil.svg"/><text class="menu-label">我的笔记</text><text class="menu-count">{{stats.notesCount}}</text><image class="row-arrow" src="/assets/icons/ui-right.svg"/></button></view>
  <view wx:if="{{recordsOpen}}" class="menu-list records-card"><button wx:for="{{courses}}" wx:key="id" class="record-row" data-id="{{item.id}}" bindtap="openCourse"><view class="record-main"><text class="record-title">{{item.title}}</text><text class="meta">{{!item.accessible ? '兑换后学习' : '已完成 ' + item.completed.length + ' / ' + item.lessons + ' 节'}}</text></view><image class="row-arrow" src="/assets/icons/ui-right.svg"/></button><text wx:if="{{!courses.length}}" class="empty-copy">还没有学习记录，选一门课程开始吧。</text></view>
  <view class="section-bar"><text class="section-title">更多服务</text></view>
  <view class="menu-list"><button class="menu-row" bindtap="redeem"><image src="/assets/icons/ui-target.svg"/><text class="menu-label">兑换更多课程</text><text class="menu-count">{{hasAccess ? '已授权' : '去兑换'}}</text><image class="row-arrow" src="/assets/icons/ui-right.svg"/></button><button class="menu-row" data-type="redeem" bindtap="showInfo"><image src="/assets/icons/ui-message.svg"/><text class="menu-label">兑换说明</text><image class="row-arrow" src="/assets/icons/ui-right.svg"/></button><button class="menu-row" data-type="help" bindtap="showInfo"><image src="/assets/icons/ui-settings.svg"/><text class="menu-label">使用帮助</text><image class="row-arrow" src="/assets/icons/ui-right.svg"/></button><button class="menu-row" bindtap="importLegacy"><image src="/assets/icons/ui-clock.svg"/><text class="menu-label">导入本机旧学习记录</text><image class="row-arrow" src="/assets/icons/ui-right.svg"/></button><button class="menu-row" bindtap="logout"><image src="/assets/icons/ui-user.svg"/><text class="menu-label">退出当前账号</text><image class="row-arrow" src="/assets/icons/ui-right.svg"/></button></view>
  <text class="footnote">新博途 · 把进步变成日常</text>
</view><glass-nav id="main-nav" active="profile" settings="{{settings}}"/><ui-sheet id="help-sheet" compact="{{true}}" visible="{{!!info}}" title="{{info.title}}" bind:close="closeInfo"><text wx:for="{{info.paragraphs}}" wx:key="*this" class="help-paragraph">{{item}}</text><ui-button slot="footer" label="我知道了" bind:activate="closeInfo"/></ui-sheet>
