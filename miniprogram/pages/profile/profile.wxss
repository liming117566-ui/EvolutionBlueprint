.profile{display:flex;align-items:center;gap:24rpx;margin:16rpx 0 44rpx}.profile-avatar{display:flex;align-items:center;justify-content:center;width:120rpx;height:120rpx;border-radius:44rpx;background:#f8d849;flex-shrink:0}.profile-avatar>image{width:64rpx;height:64rpx}.profile-main{flex:1;min-width:0}.profile-name{display:block;font-size:39rpx;font-weight:800;line-height:1.4;overflow-wrap:anywhere}.profile-copy{display:block;font-size:22rpx;color:#6e736f;margin-top:7rpx}.profile-tag{display:inline-block;font-size:19rpx;padding:6rpx 14rpx;background:#e9eee3;border-radius:14rpx;margin-top:13rpx}.stats-card{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));background:#fff;border:1rpx solid #e9ece7;border-radius:40rpx;padding:36rpx 12rpx;text-align:center}.stats-card>view{display:flex;flex-direction:column;gap:6rpx;color:#6e736f;font-size:21rpx}.stats-card .stat-number{font-size:49rpx;line-height:1.4;font-weight:750;color:#242823}.goal-banner{display:flex;align-items:center;gap:24rpx;width:100%;padding:36rpx;background:#f8d849;border-radius:40rpx;margin:38rpx 0 44rpx;text-align:left}.goal-banner>image:first-child{width:44rpx;height:44rpx;flex-shrink:0}.goal-banner>view{flex:1;min-width:0}.goal-title{display:block;font-size:29rpx;font-weight:700}.goal-copy{display:block;font-size:20rpx;color:#60571e;margin-top:8rpx}.menu-list{background:#fff;border:1rpx solid #e9ece7;border-radius:40rpx;padding:0 30rpx}.menu-row{display:flex;align-items:center;width:100%;gap:22rpx;min-height:122rpx;text-align:left}.menu-row+.menu-row{border-top:1rpx solid #e9ece7}.menu-row>image:first-child{width:41rpx;height:41rpx;flex-shrink:0}.menu-label{flex:1;min-width:0;font-size:26rpx}.menu-count{font-size:23rpx;color:#6e736f}.records-card{margin-top:24rpx}.record-row{display:flex;align-items:center;gap:20rpx;width:100%;text-align:left;min-height:118rpx;padding:20rpx 0;border-bottom:1rpx solid #e9ece7}.record-row:last-child{border:0}.record-main{flex:1;min-width:0}.record-title{display:block;font-size:26rpx;font-weight:600;margin-bottom:7rpx}.help-paragraph{display:block;margin-bottom:22rpx;font-size:26rpx;color:#6e736f;line-height:1.9}
