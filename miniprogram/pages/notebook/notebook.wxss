.notebook-page{padding-bottom:70rpx}.note-label{display:block;font-size:27rpx;font-weight:650;margin:36rpx 0 16rpx}textarea{box-sizing:border-box;display:block;width:100%;min-height:280rpx;padding:28rpx;background:#fff;border:1rpx solid #d9dfd2;border-radius:28rpx;font-size:28rpx;color:#242823;line-height:1.8;margin-bottom:30rpx}.note{padding:36rpx;background:#fff;border:1rpx solid #e9ece7;border-radius:32rpx;margin-top:24rpx}.note-text{display:block;white-space:pre-wrap;overflow-wrap:anywhere;font-size:27rpx;line-height:1.8}.note-date{display:block;font-size:20rpx;color:#6e736f;margin-top:22rpx}.plan-card{display:flex;flex-direction:column;align-items:center;padding:48rpx 32rpx;background:#f8d849;border-radius:40rpx;text-align:center}.plan-card>image{width:70rpx;height:70rpx;margin-bottom:26rpx}.plan-title{font-size:38rpx;font-weight:800}.plan-copy{font-size:24rpx;color:#60571e;margin-top:18rpx}.plan-choice{display:flex;align-items:center;justify-content:space-between;min-height:120rpx;padding:28rpx;margin-bottom:24rpx;background:#fff;border:1rpx solid #e9ece7;border-radius:30rpx;font-size:28rpx;text-align:left}.plan-choice.selected{background:#fff5c7;border-color:#242823}.plan-choice>image{width:38rpx;height:38rpx}.text-link{margin-top:24rpx;font-size:25rpx;gap:10rpx}.empty-copy{white-space:pre-line}
