<view class="video-page"><text class="video-title">{{title || '课程视频'}}</text><view wx:if="{{loading}}" class="video-state">正在验证课程权限…</view><video wx:if="{{src}}" id="course-player" class="course-player" src="{{src}}" controls show-center-play-btn enable-progress-gesture binderror="onError"/><view wx:if="{{error}}" class="video-state"><text>{{error}}</text><button bindtap="load">重新加载</button></view><text class="video-help">可横屏全屏观看，拖动进度条调整播放位置。</text></view>
